<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
 <head>
  {% render 'spdn' %}

  <!-- Google Tag Manager -->
  <script>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MXSVV32');
  </script>
  <!-- End Google Tag Manager -->

  <!-- Google tag (gtag.js) combined -->
  <!-- Theme Check Warning: External URL, safe to ignore -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-6WKK4C3QWJ"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());

    // Google Analytics 4
    gtag('config', 'G-6WKK4C3QWJ');

    // Universal Analytics (if needed)
    gtag('config', 'G-X7BE6ZYNN9');

    // Google Ads
    gtag('config', 'AW-11284981969');
  </script>

 <!-- Meta tags & fonts -->
  <meta charset="utf-8">
  {% render 'custom-meta-tags' %}
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="">
  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Favicons -->
  {% if 'favicon-16x16.png' | asset_url %}
    <link rel="icon" type="image/png" href="{{ 'favicon-16x16.png' | asset_url }}" sizes="16x16">
  {% endif %}
  {% if 'favicon-32x32.png' | asset_url %}
    <link rel="icon" type="image/png" href="{{ 'favicon-32x32.png' | asset_url }}" sizes="32x32">
  {% endif %}
  {% if 'favicon-48x48.png' | asset_url %}
    <link rel="icon" type="image/png" href="{{ 'favicon-48x48.png' | asset_url }}" sizes="48x48">
  {% endif %}

  <!-- Language alternates -->
  <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">
  <link rel="alternate" hreflang="uk-UA" href="{{ canonical_url }}">
  <link rel="alternate" hreflang="ru-UA" href="{{ canonical_url }}ru">

  <!-- Fonts preload -->
  {% unless settings.type_body_font.system? %}
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  {{ settings.type_body_font | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {% endunless %}
  {% unless settings.type_header_font.system? %}
  {{ settings.type_header_font | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {% endunless %}

  <!-- Theme styles & dynamic font CSS -->
  {% render 'meta-tags' %}
  <script src="{{ 'global.js' | asset_url }}" defer></script>
  <script src="{{ 'wss.js' | asset_url }}" defer></script>
  <script src="{{ 'custom_h1_script.js' | asset_url }}" defer></script>

  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'new.css' | asset_url | stylesheet_tag }}
  {{ 'size-chart.css' | asset_url | stylesheet_tag }}

  <!-- Conditional assets loading -->
  {% if request.page_type == 'index' or request.page_type == 'product' or request.page_type == 'page' %}
    <link rel="stylesheet" href="{{ 'component-swiper.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>{{ 'component-swiper.css' | asset_url | stylesheet_tag }}</noscript>
    <script src="{{ 'swiper.js' | asset_url }}" defer></script>
  {% endif %}

  {% if request.page_type == 'collection' %}
    <script src="{{ 'slider.js' | asset_url }}" defer></script>
  {% endif %}

  {% if request.page_type == 'product' %}
    <script src="{{ 'variants.js' | asset_url }}" defer></script>
    <script src="{{ 'size-chart.js' | asset_url }}" defer></script>
  {% endif %}

  {% if settings.predictive_search_enabled %}
    <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">
    <script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
  {% endif %}

  {% render 'wishlisthero-styles' %}

  <!-- Misc settings -->
  <meta name="google-site-verification" content="3lSZiF14Fa-u21OZGIXiMaguwBJgQnyzUqorK5vG9g0">
  <meta name="google-site-verification" content="cIoKTzCKehHrd-DQjxMORaLir9ukPggviWKS8Czw-Ho">

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
  </script>
   {{ content_for_header }}
</head>

  <body class="template-{{ request.page_type | handle }}">
    <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MXSVV32"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
   
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% section 'announcement-bar' %}

    {% if template contains 'outlet' %}
        {% section 'header-outlet' %}
    {% else %}
        {% section 'header' %}
    {% endif %}

    <main
      id="MainContent"
      class="content-for-layout focus-none{% if template.name == 'collection' %} content-for-layout-collection-mobile{% endif %} {% if template.name == 'cart' %}cart-wrap{% endif %}"
      role="main"
      tabindex="-1"
    >
      {{ content_for_layout }}
    </main>

    {% if customer.tags contains 'admin' and template.name == 'product' %}
      {% assign store_permanent_domain = shop.permanent_domain | replace: '.myshopify.com' %}
      <div class="admin-products-link">
        <a href="https://admin.shopify.com/store/{{ store_permanent_domain }}/products/{{ product.id }}" target="_blank"
          >EDIT PRODUCT
        </a>
      </div>
    {% endif %}
    {% section 'popup-cart-discount' %}
    {% if template contains 'outlet' %}
        {% section 'footer-outlet' %}
    {% else %}
        {% section 'footer' %}
    {% endif %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    </ul>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        if (window.location.pathname !== "/") {
          const cleanPath = window.location.pathname.replace(/\/+$/, '');
          const cleanUrl = window.location.origin + cleanPath + window.location.search;

          if (window.location.href !== cleanUrl) {
            window.location.replace(cleanUrl);
          }
        }

          let url = new URL(window.location.href);
          let pageParam = url.searchParams.get("page");

          if (pageParam === "1") {
            url.searchParams.delete("page");
            window.location.replace(url.href);
          }

      });
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        predictive_search_url: `{{ routes.predictive_search_url }}`
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t }}`
      }

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
      }
      window.translation = {
        cart: `{{ 'templates.cart.cart' | t }}`,
        read_more: `{{ 'general.read_more' | t }}`,
        read_less: `{{ 'general.read_less' | t }}`,
      }
      window.arrayCollectionShowGender = {{ settings.array_collection_handle_show_gender }};
    </script>

    <!-- script src="{{ 'swiper.js' | asset_url }}"></script -->
    <script src="{{ 'slider.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'variants.js' | asset_url }}" defer="defer"></script>
    <script>
      var body = document.body,
          timer;

      window.addEventListener('scroll', function() {
        clearTimeout(timer);
        if(!body.classList.contains('disable-hover')) {
          body.classList.add('disable-hover')
        }

        timer = setTimeout(function(){
          body.classList.remove('disable-hover')
        },500);
      }, false);
    </script>
    {%- if settings.predictive_search_enabled -%}
      <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {% capture notification %}{% render 'translation-lab-theme-editor-notification' %}{% endcapture %}
    {% unless notification contains "Liquid error" %}{{ notification }}{% endunless %}

  <!-- KeyCRM online chat widget begin -->
<script type="text/javascript">
(function(w,d,t,u,c){
  var s=d.createElement(t),j=d.getElementsByTagName(t)[0];s.src=u;s["async"]=true;s.defer=true;s.onload=function(){KeyCRM.render(c);};j.parentNode.insertBefore(s,j)
})(window, document, "script","https://chat.key.live/bundles/widget.min.js",{token:"bc3f252a-342f-42cb-a3a6-3219b681731b"});
</script>
<!-- KeyCRM online chat widget end -->

