<!doctype html>
{%- liquid
  assign iso_code  = request.locale.iso_code
  assign config_rtl  = settings.right_to_left | default: 'enable-with-list'
  assign is_rtl = false
  assign dir = 'ltr'
  if config_rtl == 'enable-with-list'
    assign iso_code_ck = iso_code | split: '-' | first | append: ';' | prepend: ';'
    assign lis_rtl = ';ae;ar;arc;bqi;ckb;dv;fa;glk;ha;he;kwh;ks;ku;mzn;nqo;pnb;ps;sd;ug;ur;yi;'
    if lis_rtl contains iso_code_ck
      assign is_rtl = true
      assign dir = 'rtl'
    endif
  elsif config_rtl == 'enable'
    assign is_rtl = true
    assign dir = 'rtl'
  endif
-%}
{%- if request.page_type == 'policy' -%}
  {%- capture nbk_native_policy_heading -%}<h1>{{ page_title | escape }}</h1>{%- endcapture -%}
  {%- capture nbk_policy_title -%}{%- render 'nbk-policy-title' -%}{%- endcapture -%}
  {%- assign page_title = nbk_policy_title | strip -%}
  {%- capture nbk_policy_heading -%}<h1>{{ page_title | escape }}</h1>{%- endcapture -%}
{%- endif -%}

<html class="no-js hdt-pr-img__effect-{{ settings.effect_secondary_image }} hdt-badge__shape-{{ settings.badge_shape }} dir--{{ dir }}{% if request.design_mode %} shopify-design-mode{% endif %} {% if settings.minimal_products %} hdt-minimal-products{% endif %}{% if settings.hidden_badges %} hdt-hidden-pr-badges{% endif %}{% if settings.hidden_quickview %} hdt-hidden-pr-quickview{% endif %}{% if settings.hidden_wishlist %} hdt-hidden-pr-wishlist{% endif %}{% if settings.hidden_compare %} hdt-hidden-pr-compare{% endif %}{% if settings.uppercase_title %} hdt-pr-uppercase_title{% endif %} {% if settings.layout_boxed %} hdt-layout-boxed{% endif %}" lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
  <head>
    {% render 'nbk-kyiv-head' %}
 {%- capture ecom_header_content -%}{%- render 'ecom_header' -%}{%- endcapture -%}{%- unless ecom_header_content contains 'Liquid error' -%}{{ ecom_header_content }}{%- endunless -%}
    {%- unless template == 'product.only_config' and request.design_mode == false -%}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <style>
        @font-face {
            font-family: 'Formular';
            src: url('{{ "Formular-Light.woff2" | asset_url }}') format('woff2');
            font-weight: 300;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Formular';
            src: url('{{ "Formular.woff2" | asset_url }}') format('woff2');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Formular';
            src: url('{{ "Formular-Medium.woff2" | asset_url }}') format('woff2');
            font-weight: 500;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Formular';
            src: url('{{ "Formular-Bold.woff2" | asset_url }}') format('woff2');
            font-weight: 700;
            font-style: normal;
            font-display: swap;
        }
        </style>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- endif -%}

    {%- if settings.library_font == "shopify" -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endif -%}
    {%- if settings.library_font == 'google' -%}{{ settings.embed_google_font }}{%- endif -%}
    <title>
      {%- if request.page_type == 'search' and template.suffix == 'wishlist' -%}
        {{ 'general.wishlist.wishlist_page' | t }}
      {%- else -%}
        {{ page_title }}
      {%- endif -%}
      {%- if current_tags %} &ndash; {{ 'general.meta.tag' | t }} "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t }} {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description and current_page == 1 %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {%- liquid
      render 'social-meta-tags', page_title: page_title
      render 'css-variables', is_rtl: is_rtl
      render 'js-variables'
      render 'scripts'
      if settings.custom_html_head != blank
        echo settings.custom_html_head
      endif
    -%}

    {% render 'nbk-rez-kalles' %}
    {{ content_for_header }}
    {% render 'nbk-locale-routing' %}
    {%- if request.page_type == 'policy' -%}
      {{ 'nbk-policy.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {%- if request.page_type == 'product' -%}
      {{ 'nbk-yespo-recommendations.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {% render 'fn_uk-hreflang' %}
    {%- endunless -%}
    </head>

  <body class="hdt-page-type-{{ request.page_type }}">
    {% comment %} {%- section 'product-card-configs' -%} {% endcomment %}
    {%- unless template == 'product.only_config' and request.design_mode == false -%}
    {%- if request.page_type == "index" -%}
    <h1 class="sr-only">{% render 'nbk-page-h1' %}</h1>
    {%- endif -%}
    {%- render 's-dom-temp' -%}
    <a class="skip-to-content-link button sr-only " href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>
    {%- sections 'header-group' -%}
    {%- endunless -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {% if request.page_type == 'collection' and collection.handle == 'brands' %}
        {% section 'nbk-brands-directory' %}
      {% elsif request.page_type == 'policy' %}
        {{ content_for_layout | replace_first: nbk_native_policy_heading, nbk_policy_heading }}
      {% else %}
        {{ content_for_layout }}
      {% endif %}
      {%- if template.suffix == 'only_config' -%}
        {%- section 'color-swatch' -%}
      {%- endif -%}
    </main>

    {%- unless template == 'product.only_config' and request.design_mode == false -%}
    <footer>
      {%- sections 'footer-group' -%}
    </footer>
    {%- liquid
      sections 'system-group'
      if settings.enable_compare_popup
        render 'compare-offcanvas'
      endif
      render 'system-bottom'
      if settings.custom_html_footer != blank
        echo settings.custom_html_footer
      endif
      render 'jsonld-graph'
    -%}
   {%- endunless -%}
  {%- capture ecom_footer_content -%}{%- render 'ecom_footer' -%}{%- endcapture -%}{%- unless ecom_footer_content contains 'Liquid error' -%}{{ ecom_footer_content }}{%- endunless -%}  {% render 'nbk-kyiv-checkout' %}
    {% render 'nbk-kyiv-integrations' %}
    {% render 'nbk-keycrm-chat' %}
    {%- if request.page_type == 'product' -%}
      {% render 'nbk-yespo-recommendations' %}
    {%- endif -%}
    {% render 'nbk-cart-analytics' %}
  </body>
</html>
