{%- liquid
  assign target = product
  assign product = section.settings.product | default: target
-%}
{%- capture pr_vendor_url -%}{%- render 'nbk-brand-url', vendor: product.vendor -%}{%- endcapture -%}
{%- if product.vendor != blank %}
<div class="hdt-vendor-wrapper hdt-s-text2">{{ 'products.product.vendor' | t }} <span class="hdt-productMeta__value hdt-vendor-value hdt-csecondary hdt-inline-block hdt-s-text"><a href="{{ pr_vendor_url | strip | escape }}">{{ product.vendor }}</a></span></div>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.main-product.blocks.meta.settings.show_vendor.label",
  "tag": null,
  "presets": [{ "name": "t:sections.main-product.blocks.meta.settings.show_vendor.label" }]
}
{% endschema %}