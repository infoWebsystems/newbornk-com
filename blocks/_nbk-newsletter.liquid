{% doc %}
  Opens Kyiv's published Yespo welcome form (35732), shared with the live Dawn theme.
  Yespo owns email collection, consent, double opt-in and the welcome event.
{% enddoc %}
{%- liquid
  assign form_id = 'nbk-footer-newsletter-' | append: block.id
-%}
<div class="nbk-footer-newsletter" {{ block.shopify_attributes }}>
  <h3 class="nbk-footer-newsletter__heading" id="{{ form_id }}-heading">{{ 'nbk_footer.newsletter_heading' | t }}</h3>
  <p class="nbk-footer-newsletter__text">{{ 'nbk_footer.newsletter_text' | t }}</p>
  <nbk-yespo-signup data-form-variant-id="f35732v35732">
    <button class="nbk-footer-newsletter__submit" type="button" aria-haspopup="dialog" aria-describedby="{{ form_id }}-consent" disabled>{{ 'nbk_footer.subscribe' | t }}</button>
    <p class="nbk-footer-newsletter__message" role="status" hidden>{{ 'nbk_footer.unavailable' | t }}</p>
    <noscript><p>{{ 'nbk_footer.javascript_required' | t }}</p></noscript>
    <p class="nbk-footer-newsletter__consent" id="{{ form_id }}-consent">{{ 'nbk_footer.yespo_signup_hint' | t }}</p>
  </nbk-yespo-signup>
  <script src="{{ 'nbk-yespo-signup.js' | asset_url }}" defer="defer"></script>
</div>

{% stylesheet %}
  .nbk-footer-newsletter {
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
    color: inherit;
    text-align: center;
  }
  .nbk-footer-newsletter .nbk-footer-newsletter__heading {
    margin: 0;
    color: inherit;
    font: inherit;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .nbk-footer-newsletter .nbk-footer-newsletter__text {
    margin: 16px 0 22px;
    font-size: 14px;
    line-height: 1.5;
  }
  nbk-yespo-signup {
    display: grid;
    gap: 14px;
  }
  .nbk-footer-newsletter__submit:disabled {
    cursor: wait;
    opacity: 0.65;
  }
  .nbk-footer-newsletter .nbk-footer-newsletter__submit {
    display: block;
    width: 100%;
    min-height: 50px;
    padding: 14px 18px;
    border: 0;
    border-radius: 0;
    background: #d1ff46;
    color: #111;
    font: inherit;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    text-transform: uppercase;
    cursor: pointer;
  }
  .nbk-footer-newsletter__submit:hover {
    background: #c5f235;
  }
  .nbk-footer-newsletter__submit:focus-visible,
  .nbk-footer-newsletter__consent a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }
  .nbk-footer-newsletter .nbk-footer-newsletter__message {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }
  .nbk-footer-newsletter__message ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nbk-footer-newsletter .nbk-footer-newsletter__consent {
    margin: 4px 0 0;
    font-size: 11px;
    line-height: 1.7;
  }
  .nbk-footer-newsletter__consent a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 767px) {
    .nbk-footer-newsletter .nbk-footer-newsletter__heading {
      font-size: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kyiv newsletter",
  "tag": null,
  "settings": []
}
{% endschema %}
