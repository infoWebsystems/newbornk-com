{% doc %}
  Displays Kyiv's newsletter signup using Shopify's native customer form.
{% enddoc %}
{%- liquid
  assign form_id = 'nbk-footer-newsletter-' | append: block.id
  assign privacy_url = pages['privacy-policy'].url | default: shop.privacy_policy.url
-%}
<div class="nbk-footer-newsletter" {{ block.shopify_attributes }}>
  <h3 class="nbk-footer-newsletter__heading" id="{{ form_id }}-heading">{{ 'nbk_footer.newsletter_heading' | t }}</h3>
  <p class="nbk-footer-newsletter__text">{{ 'nbk_footer.newsletter_text' | t }}</p>
  {%- form 'customer', id: form_id, class: 'nbk-footer-newsletter__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label class="nbk-footer-newsletter__label" for="{{ form_id }}-email">{{ 'nbk_footer.email' | t }}</label>
    <input
      class="nbk-footer-newsletter__email"
      id="{{ form_id }}-email"
      type="email"
      name="contact[email]"
      value="{{ form.email | escape }}"
      placeholder="{{ 'nbk_footer.email' | t | escape }}"
      autocomplete="email"
      autocorrect="off"
      autocapitalize="off"
      required
      aria-required="true"
      aria-describedby="{{ form_id }}-consent{% if form.errors %} {{ form_id }}-error{% elsif form.posted_successfully? %} {{ form_id }}-success{% endif %}"
      {% if form.errors %}aria-invalid="true" autofocus{% endif %}
    >
    <button class="nbk-footer-newsletter__submit" type="submit" name="commit">{{ 'nbk_footer.subscribe' | t }}</button>
    {%- if form.errors -%}
      <div class="nbk-footer-newsletter__message" id="{{ form_id }}-error" role="alert">{{ form.errors | default_errors }}</div>
    {%- elsif form.posted_successfully? -%}
      <p class="nbk-footer-newsletter__message" id="{{ form_id }}-success" role="status" tabindex="-1" autofocus>{{ 'nbk_footer.success' | t }}</p>
    {%- endif -%}
    <p class="nbk-footer-newsletter__consent" id="{{ form_id }}-consent">{{ 'nbk_footer.consent_html' | t: privacy_url: privacy_url }}</p>
  {%- endform -%}
</div>

{% stylesheet %}
  .nbk-footer-newsletter {
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
    color: inherit;
    text-align: center;
  }
  .nbk-footer-newsletter .nbk-footer-newsletter__heading {
    margin: 0;
    color: inherit;
    font: inherit;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.2;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .nbk-footer-newsletter .nbk-footer-newsletter__text {
    margin: 16px 0 22px;
    font-size: 14px;
    line-height: 1.5;
  }
  .nbk-footer-newsletter__form {
    display: grid;
    gap: 14px;
    position: relative;
    margin: 0;
  }
  .nbk-footer-newsletter__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .nbk-footer-newsletter .nbk-footer-newsletter__email {
    box-sizing: border-box;
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 50px;
    padding: 14px 18px;
    border: 1px solid #ddd;
    border-radius: 0;
    background: #fff;
    color: #111;
    font: inherit;
    font-size: 16px;
    line-height: 1.4;
    text-align: left;
  }
  .nbk-footer-newsletter__email::placeholder {
    color: #6b6b6b;
    opacity: 1;
  }
  .nbk-footer-newsletter .nbk-footer-newsletter__submit {
    display: block;
    width: 100%;
    min-height: 50px;
    padding: 14px 18px;
    border: 0;
    border-radius: 0;
    background: #d1ff46;
    color: #111;
    font: inherit;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    text-transform: uppercase;
    cursor: pointer;
  }
  .nbk-footer-newsletter__submit:hover {
    background: #c5f235;
  }
  .nbk-footer-newsletter__email:focus-visible,
  .nbk-footer-newsletter__submit:focus-visible,
  .nbk-footer-newsletter__consent a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }
  .nbk-footer-newsletter .nbk-footer-newsletter__message {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
  }
  .nbk-footer-newsletter__message ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nbk-footer-newsletter .nbk-footer-newsletter__consent {
    margin: 4px 0 0;
    font-size: 11px;
    line-height: 1.7;
  }
  .nbk-footer-newsletter__consent a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 767px) {
    .nbk-footer-newsletter .nbk-footer-newsletter__heading {
      font-size: 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kyiv newsletter",
  "tag": null,
  "settings": []
}
{% endschema %}
