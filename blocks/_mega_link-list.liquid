{% liquid
  assign link = block.settings.linklist
  if block.settings.title != blank and block.settings.linklist == blank
    assign map_title_lv1 = section.settings.main_menu.links | map: 'title'
    for title in map_title_lv1
      assign title_trim = title | split: '['
      if title_trim[0] == block.settings.title
        assign link = section.settings.main_menu.links | where: 'title', title | first
        assign index = section.settings.main_menu.links | find_index: 'title', title
        break
      endif
    endfor
    assign arr_title = link.title | split: '['
    assign arr_label = arr_title[1] | split: ','
  endif
%}
{%- assign nbk_columns = 0 -%}
{%- for nbk_column in link.links -%}
  {%- capture nbk_column_state -%}{%- render 'nbk-menu-state', item: nbk_column -%}{%- endcapture -%}
  {%- assign nbk_column_state = nbk_column_state | strip | split: '|' -%}
  {%- assign nbk_column_children = nbk_column_state[0] | plus: 0 -%}
  {%- if nbk_column_children > 0 or nbk_column_state[1] == '1' -%}
    {%- assign nbk_columns = nbk_columns | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- if nbk_columns > 0 -%}
<div class="hdt-row-grid hdt-grid-cols-{{ nbk_columns | at_most: 6 }} hdt-text-start">
  {%- for link in link.links -%}
{%- capture nbk_link_state -%}{%- render 'nbk-menu-state', item: link -%}{%- endcapture -%}
{%- liquid
  assign nbk_link_state = nbk_link_state | strip | split: '|'
  assign nbk_link_children = nbk_link_state[0] | plus: 0
  if nbk_link_children == 0 and nbk_link_state[1] != '1'
    continue
  endif
-%}
    <div class="hdt-mega-item hdt-text-start">
      {%- if nbk_link_children > 0 -%}
        <a class="hdt-mega-heading hdt-inline-flex hdt-align-center hdt-justify-between hdt-relative" {% if nbk_link_state[1] == '1' %}href="{{ link.url }}"{% endif %}>
          {%- assign arr_title = link.title | split: '[' -%}
          {%- assign arr_label = arr_title[1] | split: ',' -%}
          <span class="hdt-menu-link-text hdt-block{% if arr_label.size > 0 %} hdt-relative hdt-title_size-{{ arr_title[0].size | at_most: 20 }} hdt-has-{{ arr_label.size | at_most: 2 }}label{% endif %}">
            <span class="hdt-block">{{ arr_title[0] }}
              {%- if arr_label.size > 0 -%}
                <span class="hdt_label_menu hdt-inline-flex hdt-align-center hdt-justify-center hdt-text-xs">
                  {%- for label in arr_label limit: 2 -%}
                    {%- assign label_text = label | remove: 'label_' | remove: ','  | remove: ']' | strip -%}
                    <span class="hdt_label_{{ label_text | handleize }} hdt-flex hdt-align-center hdt-justify-center">{{ label_text }}</span>
                  {%- endfor -%}
                </span>
              {%- endif -%}
            </span>
          </span>
        </a>
        <ul class="hdt-mega-menu-list">
          {%- for childlink in link.links -%}
{%- capture nbk_childlink_state -%}{%- render 'nbk-menu-state', item: childlink -%}{%- endcapture -%}
{%- liquid
  assign nbk_childlink_state = nbk_childlink_state | strip | split: '|'
  assign nbk_childlink_children = nbk_childlink_state[0] | plus: 0
  if nbk_childlink_children == 0 and nbk_childlink_state[1] != '1'
    continue
  endif
-%}
            <li class="hdt-menu-item hdt-flex hdt-justify-center hdt-flex-col{% if nbk_childlink_children > 0 %} hdt-has-children hdt-relative{% endif %}">
              <a {% if nbk_childlink_state[1] == '1' %}href="{{ childlink.url }}"{% endif %} class="hdt-menu-link hdt-flex hdt-align-center hdt-justify-between hdt-relative hdt-text-base hdt-font-normal {% if childlink.current and section.settings.active_link %} hdt-menu-link--active{% endif %}" {% if childlink.current %} aria-current="page" {% endif %}>
                {%- assign arr_title = childlink.title | split: '[' -%}
                {%- assign arr_label = arr_title[1] | split: ',' -%}
                <span class="hdt-menu-link-text hdt-block{% if arr_label.size > 0 %} hdt-relative hdt-title_size-{{ arr_title[0].size | at_most: 20 }} hdt-has-{{ arr_label.size | at_most: 2 }}label{% endif %}">
                  <span class="hdt-block">{{ arr_title[0] }}
                    {%- if arr_label.size > 0 -%}
                      <span class="hdt_label_menu hdt-inline-flex hdt-align-center hdt-justify-center hdt-text-xs">
                        {%- for label in arr_label limit: 2 -%}
                          {%- assign label_text = label | remove: 'label_' | remove: ','  | remove: ']' | strip -%}
                          <span class="hdt_label_{{ label_text | handleize }} hdt-flex hdt-align-center hdt-justify-center">{{ label_text }}</span>
                        {%- endfor -%}
                      </span>
                    {%- endif -%}
                  </span>
                </span>
                {%- if nbk_childlink_children > 0 -%}
                  <svg class="hdt-menu-item-arrow" xmlns="http://www.w3.org/2000/svg" width="10" height="7" viewBox="0 0 10 7" fill="none"><path d="M10 1.24243L5 6.24243L-2.18557e-07 1.24243L0.8875 0.354932L5 4.46743L9.1125 0.354931L10 1.24243Z" fill="currentColor"/></svg>
                {%- endif -%}
              </a>
              {%- if nbk_childlink_children > 0 -%}
                <ul class="hdt-menu-list hdt-mega-sub-menu hdt-sub-menu-lever-2" role="list">
                  {%- for grandchildlink in childlink.links -%}
{%- capture nbk_grandchildlink_state -%}{%- render 'nbk-menu-state', item: grandchildlink -%}{%- endcapture -%}
{%- liquid
  assign nbk_grandchildlink_state = nbk_grandchildlink_state | strip | split: '|'
  assign nbk_grandchildlink_children = nbk_grandchildlink_state[0] | plus: 0
  if nbk_grandchildlink_children == 0 and nbk_grandchildlink_state[1] != '1'
    continue
  endif
-%}
                    <li class="hdt-menu-item hdt-flex hdt-justify-center hdt-flex-col">
                      <a {% if nbk_grandchildlink_state[1] == '1' %}href="{{ grandchildlink.url }}"{% endif %} class="hdt-menu-link hdt-flex hdt-align-center hdt-justify-between hdt-relative hdt-text-base hdt-font-normal {% if childlink.current and section.settings.active_link %} hdt-menu-link--active{% endif %}" {% if grandchildlink.current %} aria-current="page" {% endif %}>
                        {%- assign arr_title = grandchildlink.title | split: '[' -%}
                        {%- assign arr_label = arr_title[1] | split: ',' -%}
                        <span class="hdt-menu-link-text hdt-block{% if arr_label.size > 0 %} hdt-relative hdt-title_size-{{ arr_title[0].size | at_most: 20 }} hdt-has-{{ arr_label.size | at_most: 2 }}label{% endif %}">
                          <span class="hdt-block">{{ arr_title[0] }}
                            {%- if arr_label.size > 0 -%}
                              <span class="hdt_label_menu hdt-inline-flex hdt-align-center hdt-justify-center hdt-text-xs">
                                {%- for label in arr_label limit: 2 -%}
                                  {%- assign label_text = label | remove: 'label_' | remove: ','  | remove: ']' | strip -%}
                                  <span class="hdt_label_{{ label_text | handleize }} hdt-flex hdt-align-center hdt-justify-center">{{ label_text }}</span>
                                {%- endfor -%}
                              </span>
                            {%- endif -%}
                          </span>
                        </span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <a class="hdt-mega-heading hdt-flex hdt-align-center hdt-justify-between hdt-relative{% if link.current and section.settings.active_link %} hdt-menu-link--active{% endif %}" {% if nbk_link_state[1] == '1' %}href="{{ link.url }}"{% endif %} {% if link.current %} aria-current="page" {% endif %}>
          {%- assign arr_title = link.title | split: '[' -%}
          {%- assign arr_label = arr_title[1] | split: ',' -%}
          <span class="hdt-menu-link-text hdt-block{% if arr_label.size > 0 %} hdt-relative hdt-title_size-{{ arr_title[0].size | at_most: 20 }} hdt-has-{{ arr_label.size | at_most: 2 }}label{% endif %}">
            <span class="hdt-block">{{ arr_title[0] }}
              {%- if arr_label.size > 0 -%}
                <span class="hdt_label_menu hdt-inline-flex hdt-align-center hdt-justify-center hdt-text-xs">
                  {%- for label in arr_label limit: 2 -%}
                    {%- assign label_text = label | remove: 'label_' | remove: ','  | remove: ']' | strip -%}
                    <span class="hdt_label_{{ label_text | handleize }} hdt-flex hdt-align-center hdt-justify-center">{{ label_text }}</span>
                  {%- endfor -%}
                </span>
              {%- endif -%}
            </span>
          </span>
        </a>
      {%- endif -%}
    </div>
  {%- endfor -%}
</div>
{%- endif -%}
{% schema %}
  {
    "name": "Mega Link List",
    "tag": null,
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Menu item name (level 1) of main menu"
      },
      {
        "type": "link_list",
        "id": "linklist",
        "label": "Linklist",
        "visible_if": "{{ block.settings.title == blank }}"
      }
    ],
    "presets": [
      {
        "name": "Mega Link List"
      }
    ]
  }
{% endschema %}