{% liquid
  assign path = request.path | downcase
  if path contains '/outlet' or path contains '-outlet' or path contains 'autlet'
    echo '<meta name="robots" content="noindex, follow">'
  else
    echo '<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">'
  endif
%}