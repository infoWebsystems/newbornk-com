{%- comment -%}
  Renders a vendor

  Accepts:
  - vendor: {String} The vendor of the product. (required)
  - class: {String} a list class. (optional)

  Usage:
  {% render 'vendor' with card_product.vendor, class: 'xxx' %}
{%- endcomment -%}

{%- capture vendor_url -%}{%- render 'nbk-brand-url', vendor: vendor -%}{%- endcapture -%}

<span class="sr-only">{{ 'accessibility.vendor' | t }}</span>
<a href="{{ vendor_url | strip | escape }}" class="hdt-card-product__vendor {{ class }}">{{ vendor | escape }}</a>