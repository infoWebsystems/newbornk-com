{%- liquid
  assign real_count = 0

  if filter_value_label != blank
    for product in collection.products
      capture can
        render 'fn_validate_product', product: product
      endcapture
      assign can = can | plus: 0

      if can == 1
        for variant in product.variants
          if variant.title == filter_value_label
            if variant.available and variant.inventory_quantity > 0
              assign real_count = real_count | plus: 1
            endif
          endif
        endfor
      endif
    endfor
  endif
-%}
{{ real_count }}
