{%- comment -%}
  Renders a size list

  Accepts:
  - size_variants: {Array} (required)
  - size_variants_avai: {Array} (required)
  - size_count: {Interger} (required)
  - class: {String} a list class. (optional)

  Usage:
  {% render 'size-list', size_variants: size_variants, size_variants_avai: size_variants_avai %}
{%- endcomment -%}
{%- liquid  
  assign size_list = 'products.theme_settings.size' | t | downcase | strip | replace: ' ,', ',' | replace: ', ', ',' | split: ',' | uniq
-%}

{%- for option in product.options_with_values -%}
  {%- liquid
    assign option_downcase = option.name | downcase
    assign is_size = false
    if size_list contains option_downcase
      assign is_size = true
    endif
    assign is_footwear_size = false
    assign values_to_render = option.values
    if is_size and product.tags contains 'Взуття'
      assign is_footwear_size = true
      capture footwear_order
        render 'nbk-footwear-size-order', option: option
      endcapture
      assign values_to_render = footwear_order | split: '|' | sort
    endif
  -%}
  {%- if is_size -%}
    {%- if settings.size_mode == 'size' -%} 
      {%- liquid
        assign index = 0
        assign size_maximum = settings.size_maximum
        if settings.size_maximum == 0
          assign size_maximum = 2
        endif
        assign first = true
      -%}
      <hdt-variant-option class="hdt-variant-option--size hdt-pe-none{% if is_footwear_size %} nbk-footwear-card-sizes{% endif %} {{ class }}" data-option-position="{{ forloop.index }}" event="click" {%- if is_size %} maximum="{{ size_maximum }}"{% if settings.enable_size_limit and option.values.size > size_maximum %} action-{{ settings.size_action }}{% endif %}{% if settings.enable_size_limit and settings.size_maximum == 0 %} auto-limit{% endif %}{%- endif -%}>
        <span class="hdt-variant-label">{% if is_footwear_size %}EU{% else %}{{ option.name }}{% endif %}:</span>
        <span class="hdt-variant-selected" update-value>{{ option.selected_value }}</span>
        
        <fieldset class="hdt-variants-list">
          {%- for option_entry in values_to_render -%}
            {%- liquid
              assign value = option_entry
              if is_footwear_size
                assign original_index = option_entry | split: ':' | last | plus: 0
                assign value = option.values[original_index]
              endif
              unless value.variant
                continue
              endunless
              if settings.size_type == 'only' and value.variant.available == false
                continue
              endif
              assign index = index | plus: 1
            -%}
            <div class="hdt-swatch-item {%- if value == option.selected_value %} active{% endif %} {%- if settings.enable_size_limit and index > size_maximum and first %}{% assign first = false %} is--swatch-limit{% endif %}" data-available="{{ value.variant.available | json }}" {%- if section.id contains 'search' or section.id contains 'exit' %} inner{% endif %} placement="top" {% if settings.size_type == 'only' and value.variant.available == false %} hidden{% endif %}>
              <hdt-swatch-card class="hdt-swatch-card" data-opt="{{ option.position }}" data-vrid="{{ value.variant.id }}" data-product-url="{{ value.product_url }}" data-value-id="{{ value.id }}">
                <span class="hdt-swatch-title">{%- if is_footwear_size -%}{%- capture eu_size -%}{%- render 'nbk-footwear-size', raw_size: value, variant: value.variant -%}{%- endcapture -%}{{ eu_size | default: value | escape }}{%- else -%}{{ value }}{%- endif -%}</span>
              </hdt-swatch-card>
            </div>
          {%- endfor -%}
          {%- if size_list contains option_downcase and settings.enable_size_limit and index > size_maximum -%}
            <hdt-tooltip class="hdt-swatch-item is--swatch-link">
              <a data-pr-url href="{{ product_url }}" title="{{ 'products.product.show_more_sizes' | t | escape }}">+{{ index | minus: size_maximum | abs }}</a>
            </hdt-tooltip>
          {%- endif -%}
        </fieldset>
      </hdt-variant-option>
    {%- elsif settings.size_mode == 'count' -%}
      <div class="hdt-size-list">
        <p class="hdt-size-count">{{- 'products.product.sizes_count' | t: count: option.values.size -}}</p>
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{% stylesheet %}
  .hdt-variant-option--size.nbk-footwear-card-sizes .hdt-variant-label {
    display: inline-block;
    margin-inline-end: 6px;
    white-space: nowrap;
  }
  .hdt-variant-option--size.nbk-footwear-card-sizes .hdt-variants-list {
    gap: 0 8px;
  }
  .hdt-variant-option--size.nbk-footwear-card-sizes .hdt-swatch-item:not(:last-child)::after {
    content: none;
  }
  .hdt-variant-option--size.nbk-footwear-card-sizes .hdt-swatch-title {
    white-space: nowrap;
  }
{% endstylesheet %}
