{%- comment -%}
  Read a literal EU footwear size; never convert US or CM measurements.
  Accepts raw_size, variant, and optional output: 'sort_key'. Blank means unknown.
  A literal EU value guards against a stale metafield after an external import.
{%- endcomment -%}
{%- liquid
  assign source = raw_size | upcase | replace: 'EURO:', 'EU:' | replace: 'СМ:', 'CM:'
  assign eu_size = ''
  if source contains 'EU:'
    assign eu_size = source | split: 'EU:' | last | split: 'CM:' | first | split: 'US:' | first | split: '•' | first | replace: ':', '' | strip
    assign last_character = eu_size | slice: -1, 1
    if last_character == '/'
      assign eu_size = eu_size | remove_last: '/' | strip
    endif
  else
    assign eu_size = variant.metafields.custom.footwear_size_eu.value | default: '' | strip
  endif
  assign eu_size = eu_size | replace: ',', '.' | replace: '⅓', ' 1/3' | replace: '⅔', ' 2/3' | replace: '½', '.5' | replace: '  ', ' ' | strip
  assign parts = eu_size | split: ' '
  assign number_text = parts.first
  assign number_parts = number_text | split: '.'
  assign non_numeric = number_text | remove: '.' | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
  assign size_number = number_text | plus: 0.0
  assign valid_size = false
  if non_numeric == blank and number_parts.size <= 2 and size_number >= 10 and size_number <= 80
    if parts.size == 1
      assign valid_size = true
    elsif parts.size == 2 and number_parts.size == 1
      case parts.last
        when '1/3'
          assign size_number = size_number | plus: 0.333
          assign valid_size = true
        when '2/3'
          assign size_number = size_number | plus: 0.667
          assign valid_size = true
        when '1/2'
          assign size_number = size_number | plus: 0.5
          assign valid_size = true
      endcase
    endif
  endif
  if valid_size
    if output == 'sort_key'
      assign sort_key = size_number | times: 1000 | round | prepend: '000000' | slice: -6, 6
      echo sort_key
    else
      echo eu_size
    endif
  endif
-%}
