{% doc %}
  Renders social metadata and descriptions for subsequent pages, preserving the homepage share image.
{% enddoc %}
{% liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_image = page_image

  if request.page_type == 'policy' and page_description == nil
    assign policy_handle = request.path | split: '/' | last
    case policy_handle
      when 'privacy-policy'
        assign policy_description = 'nbk_seo.privacy_description' | t
      when 'terms-of-service'
        assign policy_description = 'nbk_seo.terms_description' | t
    endcase
    if policy_description != blank
      assign og_description = policy_description
    endif
  endif

  if request.page_type == 'index'
    assign og_image = images['Frame_567194.jpg'] | default: page_image
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

{%- if current_page > 1 and page_description != blank -%}
  {%- capture paginated_description -%}{{ 'general.meta.page' | t }} {{ current_page }}. {{ page_description }}{%- endcapture -%}
  <meta name="description" content="{{ paginated_description | escape }}">
{%- endif -%}
{%- if policy_description != blank -%}
  <meta name="description" content="{{ policy_description | escape }}">
{%- endif -%}

{%- case request.page_type -%}
  {%- when 'index' -%}
    {%- if settings.home_keywords != blank -%}
      <meta name="keywords" content="{{ settings.home_keywords }}"/>
    {%- else -%}
      <meta name="keywords" content="{{ shop.name | escape }}, {{ shop.name }}"/>
    {%- endif -%}
  {%- when 'product' -%}
    <meta name="keywords" content="{{ product.title | escape }}, {{ shop.name | escape }}, {{ shop.name }}"/>
  {%- when 'collection' -%}
    <meta name="keywords" content="{{ collection.title | escape }}, {{ shop.name | escape }}, {{ shop.name }}"/>
  {%- when 'blog' -%}
    <meta name="keywords" content="{{ blog.title | escape }}, {{ shop.name | escape }}, {{ shop.name }}"/>
  {%- when 'article' -%}
    <meta name="keywords" content="{{ article.title | escape }}, {{ blog.title | escape }}, {{ shop.name | escape }}, {{ shop.name }}"/>
  {%- when 'search' -%}
    <meta name="keywords" content="{{ page_title | escape }}, {{ shop.name | escape }}, {{ shop.domain }}"/>
{%- endcase -%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if og_image -%}
  {%- liquid
    assign og_image_width = og_image.width | at_most: 1200
    assign og_image_height = og_image.height | times: 1.0 | times: og_image_width | divided_by: og_image.width | round
  -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: og_image_width }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: og_image_width }}">
  <meta property="og:image:width" content="{{ og_image_width }}">
  <meta property="og:image:height" content="{{ og_image_height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_x_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_x_link | split: 'x.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
