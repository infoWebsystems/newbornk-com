{% liquid
  assign can = 0
  if product != blank
    assign is_outlet_template = false
    if template contains 'outlet'
      assign is_outlet_template = true
    endif

    assign tags = product.tags | join: ', ' | downcase
    assign is_tag_outlet = false
    if tags contains 'outlet' or tags contains 'Outlet'
      assign is_tag_outlet = true
    endif

    assign is_product_outlet = false

    if is_tag_outlet == true and product.template_suffix == 'default-outlet'
      assign is_product_outlet = true
    endif

    if is_outlet_template == true and is_product_outlet == true
      assign can = 1
    elsif is_outlet_template == false and is_product_outlet == false
      assign can = 1
    endif
  endif
%}
{{ can }}
