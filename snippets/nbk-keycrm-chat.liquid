{% doc %}
  Kyiv's KeyCRM customer-support channel. Each language uses a public storefront
  widget identifier; both widgets route to the existing support channel.
{% enddoc %}
{%- liquid
  assign keycrm_widget_token = 'bc3f252a-342f-42cb-a3a6-3219b681731b'
  if request.locale.iso_code == 'en'
    assign keycrm_widget_token = 'b3871707-9529-4524-800a-476735d3b8c6'
  endif
-%}
<script
  src="{{ 'nbk-keycrm-chat.js' | asset_url }}"
  data-widget-token="{{ keycrm_widget_token }}"
  defer
></script>

{% stylesheet %}
  @media (max-width: 1024px) {
    body:has(.hdt-toolbar) .KeyCRM-toggleButtonContainer {
      right: 6.5rem !important;
      bottom: calc(var(--toolbar-height, 5.5rem) + 1.5rem + env(safe-area-inset-bottom, 0px)) !important;
    }

    body.sticky-shown:has(.hdt-toolbar) .KeyCRM-toggleButtonContainer {
      bottom: calc(var(--toolbar-height, 5.5rem) + var(--hdt-sticky-atc-height, 0px) + 1.5rem + env(safe-area-inset-bottom, 0px)) !important;
    }
  }
{% endstylesheet %}
