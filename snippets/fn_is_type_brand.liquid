{%- liquid
  assign current_url = request.host | append: request.path
  assign current_path = request.path
  assign active_filters = ''

  for filter in collection.filters
    for value in filter.active_values
      assign active_filters = active_filters | append: value.label | append: ', '
    endfor
  endfor

  assign should_show_menu = false
  assign is_oakley = 0
  assign is_carhartt_wip = 0

  if settings.brand_type_oakley_menu != blank and settings.brand_type_oakley_list != blank
    assign should_show_menu = false

    for link in settings.brand_type_oakley_list.links
      assign link_url = link.url | strip

      # Проверяем несколько вариантов совпадения
      if link_url == current_url or link_url == current_path or current_url contains link_url or current_path contains link_url or request.path contains link_url or request.full_url contains link_url
        assign should_show_menu = true
        break
      endif
    endfor

    if should_show_menu == false and active_filters contains 'OAKLEY'
      assign should_show_menu = true
    endif

    if should_show_menu == true
      assign is_oakley = 1
    endif
  endif

  if should_show_menu == false and settings.brand_type_carhartt_wip_menu != blank and settings.brand_type_carhartt_wip_list != blank
    for link in settings.brand_type_carhartt_wip_list.links
      assign link_url = link.url | strip

      # Проверяем несколько вариантов совпадения
      if link_url == current_url or link_url == current_path or current_url contains link_url or current_path contains link_url or request.path contains link_url or request.full_url contains link_url
        assign should_show_menu = true
        break
      endif
    endfor

    if should_show_menu == false and active_filters contains 'CARHARTT WIP'
      assign should_show_menu = true
    endif
    if should_show_menu == true
      assign is_carhartt_wip = 1
    endif
  endif
-%}
{% if should_show_menu == true %}1|{{ is_oakley }}|{{ is_carhartt_wip }}{% endif %}
