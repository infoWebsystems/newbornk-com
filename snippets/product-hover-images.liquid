{% assign is_recommendations_section = false %}

{% if is_recommendations %}
  {% assign is_recommendations_section = true %}
{% endif %}

{% assign gender_prefix = '' %}
{% if collection.handle contains 'zhin' or collection.handle contains 'жіноч' or collection.handle contains 'women' %}
  {% assign gender_prefix = 'women' %}
{% elsif collection.handle contains 'cholo' or collection.handle contains 'чолов' or collection.handle contains 'men' %}
  {% assign gender_prefix = 'men' %}
{% endif %}

{% assign is_accessory = false %}
{% if product.tags contains 'Аксесуари' %}
  {% assign is_accessory = true %}
{% endif %}

{% assign first_image = '' %}
{% assign second_image = '' %}

{% if is_accessory %}
  {% assign first_image = product.media[0] %}
  {% assign second_image = product.media[2] %}
  {% if second_image == blank %}
    {% assign second_image = first_image %}
  {% endif %}
{% else %}

  {% if gender_prefix contains 'men' or gender_prefix contains 'women'%} {% comment %} Check for collection? tht we are'nt on the home or product page {% endcomment %}
    {% assign first_image = product.media[0] %}
    {% assign packshot = false %}
    {% assign first_image_alt = first_image.alt | escape | split: '#@' | first | strip %}

    <h2>first_image_alt: {{ first_image_alt }}</h2>

    {% unless first_image_alt contains 'men' or first_image_alt contains 'women' %}
      {% assign packshot = true %}
    {% endunless %}
    {% if packshot == false %}
      {% assign first_image = '' %}
    {% endif %}
  {% endif %}

  <h2>packshot: {{ packshot }}</h2>

  {% for media in product.media %}
    {% assign alt = media.alt | escape %}
    {% assign prefix = alt | split: '#@' | first | strip %}

    <h1>prefix alt img: {{ prefix }}</h1>

    {% if packshot %} {% comment %} First PackShot {% endcomment %}
      {% if gender_prefix != '' and prefix == gender_prefix %}
        {% if second_image == '' %}
          {% assign second_image = media %}
        {% endif %}
      {% endif %}
    {% else %} {% comment %} First men or women {% endcomment %}

      {% if gender_prefix != '' and prefix == gender_prefix %}
        {% if first_image == '' %}
          {% assign first_image = media %}
        {% elsif second_image == '' %}
          {% assign second_image = media %}
        {% endif %}
      {% endif %}

    {% endif %}

  {% endfor %}

  {% comment %} OLD Logick
    {% for media in product.media %}
      {% assign alt = media.alt | escape %}
      {% assign prefix = alt | split: '#@' | first | strip %}

      {% if gender_prefix != '' and prefix == gender_prefix %}
        {% if first_image == '' %}
          {% assign first_image = media %}
        {% elsif second_image == '' %}
          {% assign second_image = media %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endcomment %}

  {% if first_image == '' and second_image == '' %}
    {% assign first_image = product.media[0] %}
    {% assign second_image = product.media[1] %}
  {% elsif first_image != '' and second_image == '' %}
    {% assign second_image = first_image %}
  {% endif %}
{% endif %}

{% if first_image != blank %}
  <img
    src="{{ first_image | img_url: '533x' }}"
    alt="{{ first_image.alt | escape }}"
    {% if loop_index == blank or loop_index > 2 %}
      loading="lazy"
    {% else %}
      loading="eager" fetchpriority="high"
    {% endif %}
    width="{{ first_image.width }}"
    height="{{ first_image.height }}"
  >
{% endif %}

{% if second_image != blank and show_secondary_image %}
  <img
    src="{{ second_image | img_url: '533x' }}"
    alt="{{ second_image.alt | escape }}"
    loading="lazy"
    width="{{ second_image.width }}"
    height="{{ second_image.height }}"
  >

  {% if template.name == 'product' or is_recommendations_section %}
    {% for product_media in product.media %}
      {% if forloop.index0 > 2 %}
        <img
          src="{{ product_media | img_url: '533x' }}"
          alt="{{ product_media.alt | escape }}"
          loading="lazy"
          width="{{ product_media.width }}"
          height="{{ product_media.height }}"
        >
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}
