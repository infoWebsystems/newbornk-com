{% doc %}
  Displays a compact, localized summary of the payment and delivery methods.
  @param {string} [page_url] - The localized URL of the full payment and delivery policy.
{% enddoc %}
<div class="nbk-product-delivery">
  <div class="nbk-product-delivery__groups">
  <div class="nbk-product-delivery__group">
    <h3 class="nbk-product-delivery__heading">{{ 'nbk_delivery.payment_heading' | t }}</h3>
    {% render 'nbk-product-payment-methods' %}
  </div>
  <div class="nbk-product-delivery__group">
    <h3 class="nbk-product-delivery__heading">{{ 'nbk_delivery.delivery_heading' | t }}</h3>
    <ul class="nbk-product-delivery__list" role="list">
      <li class="nbk-product-delivery__row">
        <strong class="nbk-product-delivery__name">{{ 'nbk_delivery.nova_poshta_title' | t }}</strong>
        <p class="nbk-product-delivery__description">{{ 'nbk_delivery.nova_poshta_description' | t }}</p>
      </li>
      <li class="nbk-product-delivery__row">
        <strong class="nbk-product-delivery__name">{{ 'nbk_delivery.ukrposhta_title' | t }}</strong>
        <p class="nbk-product-delivery__description">{{ 'nbk_delivery.ukrposhta_description' | t }}</p>
      </li>
      <li class="nbk-product-delivery__row">
        <strong class="nbk-product-delivery__name">{{ 'nbk_delivery.pickup_title' | t }}</strong>
        <p class="nbk-product-delivery__description">{{ 'nbk_delivery.pickup_description' | t }}</p>
      </li>
      <li class="nbk-product-delivery__row">
        <strong class="nbk-product-delivery__name">{{ 'nbk_delivery.uklon_title' | t }}</strong>
        <p class="nbk-product-delivery__description">{{ 'nbk_delivery.uklon_description' | t }}</p>
      </li>
    </ul>
  </div>
  </div>
  <p class="nbk-product-delivery__note">{{ 'nbk_delivery.checkout_note' | t }}</p>
  {%- if page_url != blank -%}
    <p class="nbk-product-delivery__terms"><a href="{{ page_url | escape }}">{{ 'nbk_delivery.full_terms' | t }}</a></p>
  {%- endif -%}
</div>
{% stylesheet %}
  .nbk-product-delivery {
    container-type: inline-size;
    font-size: 14px;
    line-height: 1.5;
  }
  .nbk-product-delivery .nbk-product-delivery__group {
    margin: 0;
  }
  .nbk-product-delivery .nbk-product-delivery__groups {
    display: grid;
    gap: 20px;
  }
  .nbk-product-delivery .nbk-product-delivery__heading {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 16px;
    font-weight: var(--font-medium);
    line-height: 1.5;
    text-transform: none;
  }
  .nbk-product-delivery .nbk-product-delivery__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nbk-product-delivery .nbk-product-delivery__row {
    margin: 0;
    padding: 10px 0;
    list-style: none;
    border-bottom: 1px solid rgb(var(--color-line-border) / 0.5);
  }
  .nbk-product-delivery .nbk-product-delivery__name {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 14px;
    font-weight: var(--font-medium);
    line-height: 1.5;
  }
  .nbk-product-delivery .nbk-product-delivery__description {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.5;
  }
  .nbk-product-delivery .nbk-product-delivery__note {
    margin: 16px 0 0;
    font-size: 14px;
    line-height: 1.5;
  }
  .nbk-product-delivery .nbk-product-delivery__terms {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.5;
  }
  @container (min-width: 620px) {
    .nbk-product-delivery .nbk-product-delivery__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 28px;
    }
  }
{% endstylesheet %}
