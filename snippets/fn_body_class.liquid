{% liquid
  assign was = 'template-' | append: request.page_type | handle
  assign page_type = request.page_type | replace: '/', '-'
  assign page_template = template.suffix
  assign class = ''
  if page_type != blank and page_template != blank and page_type != page_template
    assign class = page_type | prepend: 'template-' | append: '-' | append: page_template
  else
    assign class = page_type | prepend: 'template-'
  endif

  if class == was
    assign class = ''
  endif

  assign class_id = ''
  if page_type == 'collection'
    assign class_id = 'collection-' | append: collection.id
  elsif page_type == 'product'
    assign class_id = 'product-' | append: product.id
  endif

  assign class = class | append: ' ' | append: class_id | strip
%}
{{ class | strip }}
