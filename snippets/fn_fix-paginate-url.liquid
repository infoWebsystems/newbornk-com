{% comment %}
  remove page=1 and phcursor from url
   var url: url
   return string fixed url
{% endcomment %}
{%- liquid
  assign cleaned_url = ''

  if url != blank
    assign split_url = url | split: '?'
    assign base_path = split_url[0]
    assign query_string = split_url[1] | default: ''

    assign clean_params = ''
    assign params = query_string | split: '&'

    for param in params
      assign pair = param | split: '='
      assign key = pair[0]
      assign value = pair[1]

      assign is_phcursor = false
      assign is_page_1 = false

      if key == 'phcursor'
        assign is_phcursor = true
      endif

      if key == 'page' and value == '1'
        assign is_page_1 = true
      endif

      unless is_phcursor or is_page_1
        if clean_params != ''
          assign clean_params = clean_params | append: '&'
        endif
        assign clean_params = clean_params | append: key | append: '=' | append: value
      endunless
    endfor

    if clean_params != ''
      assign cleaned_url = base_path | append: '?' | append: clean_params
    else
      assign cleaned_url = base_path
    endif
  endif
  echo cleaned_url | strip
-%}
