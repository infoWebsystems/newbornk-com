{% doc %}
  Preserves Kyiv's existing Yespo account inbox and Ahrefs analytics integration.
{% enddoc %}
<script async src="https://analytics.ahrefs.com/analytics.js" data-key="yEb09riFW9kGssXJWXQh1Q"></script>
<script>
  window.addEventListener('load', function () {
    if (typeof window.es !== 'function') return;
    {% if customer %}
      window.es('setCustomer', {
        email: {{ customer.email | json }},
        firstName: {{ customer.first_name | json }},
        lastName: {{ customer.last_name | json }}
      });
    {% endif %}
    window.es('appInbox.init');
    window.es('appInbox.checkMessages');
  }, { once: true });
</script>
