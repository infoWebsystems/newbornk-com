{% doc %}
  Adds localized LiqPay and PrivatBank payment information after the existing payment card.
{% enddoc %}
<div class="section nbk-payment-method">
  <div class="nbk-payment-method__brand">
    <img class="nbk-payment-method__logo" src="{{ 'nbk-payment-liqpay.svg' | asset_url }}" alt="LiqPay" width="500" height="104" loading="lazy">
  </div>
  <h4>{{ 'nbk_payments.liqpay_title' | t }}</h4>
  <p>{{ 'nbk_payments.liqpay_description' | t }}</p>
</div>
<div class="section nbk-payment-method">
  <div class="nbk-payment-method__brand">
    <img class="nbk-payment-method__logo nbk-payment-method__logo--privat" src="{{ 'nbk-payment-privat-installments.png' | asset_url }}" alt="{{ 'nbk_payments.privat_title' | t | escape }}" width="403" height="225" loading="lazy">
  </div>
  <h4>{{ 'nbk_payments.privat_title' | t }}</h4>
  <p>{{ 'nbk_payments.privat_description' | t }}</p>
</div>
{% stylesheet %}
  .nbk-payment-method__brand {
    display: flex;
    align-items: center;
    min-height: 60px;
    margin-bottom: 12px;
  }
  .nbk-product-delivery .nbk-payment-method__logo {
    display: block;
    width: 150px;
    height: auto;
    max-width: 100%;
    margin: 0;
    object-fit: contain;
    object-position: left center;
  }
  .nbk-product-delivery .nbk-payment-method__logo--privat {
    width: 220px;
  }
{% endstylesheet %}
