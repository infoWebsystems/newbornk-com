{%- comment -%}
  Emits a comprehensive Product/ProductGroup JSON-LD for the current product.
  Uses the same @id as Shopify's canonical product reference so crawlers merge
  this enrichment with any existing Product block from third-party SEO apps.

  Adds (vs typical third-party output):
    - sku, mpn, gtin (from variant metafields if present)
    - aggregateRating + reviewCount (from Air Reviews, Loox, or SPR metafields)
    - itemCondition, productID
    - color, size, material (from option_with_values)
    - category (product_type)
    - isVariantOf -> ProductGroup with variants array
    - priceValidUntil
    - size, description, shippingDetails, hasMerchantReturnPolicy on each hasVariant item
{%- endcomment -%}
{%- if product != blank -%}
  {%- assign product_id = canonical_url | split: '?' | first | append: '#product' -%}
  {%- assign group_id = canonical_url | split: '?' | first | append: '#product-group' -%}
  {%- assign brand_name = product.vendor | default: shop.name -%}
  {%- assign price_until = 'now' | date: '%Y' | plus: 1 | append: '-12-31' -%}

  {%- comment -%} Detect color/size/material option positions {%- endcomment -%}
  {%- assign color_value = '' -%}
  {%- assign size_value = '' -%}
  {%- assign material_value = '' -%}
  {%- assign size_option_index = 0 -%}
  {%- for opt in product.options_with_values -%}
    {%- assign optname = opt.name | downcase -%}
    {%- assign first_val = opt.values | first -%}
    {%- if optname contains 'color' or optname contains 'колір' or optname contains 'цвет' -%}
      {%- assign color_value = first_val -%}
    {%- elsif optname contains 'size' or optname contains 'розмір' or optname contains 'размер' -%}
      {%- assign size_value = first_val -%}
      {%- assign size_option_index = forloop.index -%}
    {%- elsif optname contains 'material' or optname contains 'матеріал' or optname contains 'материал' -%}
      {%- assign material_value = first_val -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} Detect rating from Judge.me {%- endcomment -%}
  {%- assign rating_value = '' -%}
  {%- assign rating_count = 0 -%}
  {%- assign jdgm_raw = product.metafields.judgeme.review_widget_data -%}
  {%- if jdgm_raw != blank -%}
    {%- assign jdgm_json = jdgm_raw | parse_json -%}
    {%- assign rating_value = jdgm_json.average_rating -%}
    {%- assign rating_count = jdgm_json.number_of_reviews | plus: 0 -%}
  {%- endif -%}

  {%- comment -%} Shared shipping + return policy JSON fragment {%- endcomment -%}
  {%- capture shipping_return_json -%}
"shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": "UAH" },
        "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "UA" },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": {
            "@type": "QuantitativeValue",
            "minValue": 0,
            "maxValue": 1,
            "unitCode": "DAY"
          },
          "transitTime": {
            "@type": "QuantitativeValue",
            "minValue": 1,
            "maxValue": 3,
            "unitCode": "DAY"
          }
        }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "UA",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 14,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
  {%- endcapture -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ product_id | json }},
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | strip_newlines | strip | truncate: 5000 | json }},
  "url": {{ canonical_url | split: '?' | first | json }},
  {%- if product.featured_image -%}
  "image": [
    {%- for media in product.media limit: 6 -%}
      {{ media | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  {%- endif -%}
  "brand": {
    "@type": "Brand",
    "name": {{ brand_name | json }}
  },
  "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
  "mpn": {{ product.selected_or_first_available_variant.sku | default: product.id | json }},
  "productID": {{ product.id | json }},
  {%- if product.type != blank -%}
  "category": {{ product.type | json }},
  {%- endif -%}
  {%- if color_value != '' -%}
  "color": {{ color_value | json }},
  {%- endif -%}
  {%- if size_value != '' -%}
  "size": {{ size_value | json }},
  {%- endif -%}
  {%- if material_value != '' -%}
  "material": {{ material_value | json }},
  {%- endif -%}
  {%- if rating_value != '' and rating_count > 0 -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating_value | json }},
    "reviewCount": {{ rating_count }},
    "bestRating": 5,
    "worstRating": 1
  },
  {%- endif -%}
  {%- if product.has_only_default_variant -%}
  "offers": {
    "@type": "Offer",
    "url": {{ canonical_url | split: '?' | first | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ product.price | divided_by: 100.0 | json }},
    "availability": "{%- if product.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}",
    "itemCondition": "https://schema.org/NewCondition",
    "priceValidUntil": {{ price_until | json }},
    {{ shipping_return_json }},
    "seller": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
  {%- else -%}
  "isVariantOf": { "@id": {{ group_id | json }} },
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      "url": {{ shop.url | append: variant.url | json }},
      "sku": {{ variant.sku | default: variant.id | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "availability": "{%- if variant.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}",
      "itemCondition": "https://schema.org/NewCondition",
      "priceValidUntil": {{ price_until | json }},
      {{ shipping_return_json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- endif -%}
}
</script>

{%- unless product.has_only_default_variant -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProductGroup",
  "@id": {{ group_id | json }},
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | strip_newlines | strip | truncate: 5000 | json }},
  "url": {{ canonical_url | split: '?' | first | json }},
  "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
  "productGroupID": {{ product.id | json }},
  {%- if product.type != blank -%}
  "category": {{ product.type | json }},
  {%- endif -%}
  "variesBy": [
    {%- for opt in product.options_with_values -%}
      {{ opt.name | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "hasVariant": [
    {%- for variant in product.variants -%}
    {
      "@type": "Product",
      "sku": {{ variant.sku | default: variant.id | json }},
      "name": {{ variant.title | json }},
      "description": {{ product.description | strip_html | strip_newlines | strip | truncate: 5000 | json }},
      "image": {{ variant.image | default: product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
      {%- if size_option_index == 1 -%}
      "size": {{ variant.option1 | json }},
      {%- elsif size_option_index == 2 -%}
      "size": {{ variant.option2 | json }},
      {%- elsif size_option_index == 3 -%}
      "size": {{ variant.option3 | json }},
      {%- endif -%}
      "offers": {
        "@type": "Offer",
        "url": {{ shop.url | append: variant.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "availability": "{%- if variant.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}",
        "itemCondition": "https://schema.org/NewCondition",
        "priceValidUntil": {{ price_until | json }},
        {{ shipping_return_json }}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endunless -%}
{%- endif -%}
