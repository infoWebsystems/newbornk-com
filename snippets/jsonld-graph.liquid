{% doc %}
  Renders Kyiv's connected organization, product, collection and article structured data.
{% enddoc %}
{%- comment -%}
  ============================================================
  jsonld-graph.liquid — Consolidated JSON-LD @graph for newbornk.com
  ============================================================
  
  Renders ONE <script type="application/ld+json"> with a @graph array
  containing all relevant schema.org entities for the current page,
  connected via @id cross-references (Google's recommended pattern).
  
  Replaces:
    - Hardcoded @graph in theme.liquid (Website + ClothingStore + broken BreadcrumbList)
    - jsonld-product.liquid (Product + ProductGroup) — inlined here, old file removed
    - Avada's review/article/breadcrumb schema (disabled in Avada UI)
  
  Entities emitted ALWAYS:
    - WebSite (#website)
    - ClothingStore / LocalBusiness (#organization)
  
  Entities emitted CONDITIONALLY:
    - BreadcrumbList (#breadcrumb) — dynamic from template context
    - Product + ProductGroup — only on product pages
    - CollectionPage + ItemList — only on collection pages
    - Article / BlogPosting — only on article pages
  
  Cross-references via @id:
    - Product → isVariantOf → ProductGroup (variants); brand → vendor (string only)
    - Product → seller → Organization
    - BreadcrumbList → isPartOf → WebPage (current)
{%- endcomment -%}

{%- liquid
  assign site_url = 'https://newbornk.com'
  assign website_id = site_url | append: '#website'
  assign org_id = site_url | append: '#organization'
  assign canonical_clean = canonical_url | split: '?' | first
  assign breadcrumb_id = canonical_clean | append: '#breadcrumb'
  assign price_until = 'now' | date: '%Y' | plus: 1 | append: '-12-31'
-%}

<script type="application/ld+json" data-desc="jsonld-graph">
{
  "@context": "https://schema.org",
  "@graph": [

    {%- comment -%} ========== WebSite ========== {%- endcomment -%}
    {
      "@type": "WebSite",
      "@id": {{ website_id | json }},
      "name": "NEWBORN K",
      "alternateName": "newbornk.com",
      "url": {{ site_url | json }},
      "description": "Концепт-стор з унікальною селекцією одягу, взуття та аксесуарів.",
      "inLanguage": ["uk-UA", "ru-UA"],
      "publisher": { "@id": {{ org_id | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://newbornk.com/search?q={search_term_string}&type=product"
        },
        "query-input": "required name=search_term_string"
      }
    },

    {%- comment -%} ========== ClothingStore (Organization + LocalBusiness) ========== {%- endcomment -%}
    {
      "@type": ["Organization", "ClothingStore"],
      "@id": {{ org_id | json }},
      "name": "NEWBORN K",
      "legalName": "NEWBORN K",
      "url": {{ site_url | json }},
      "logo": {
        "@type": "ImageObject",
        "url": "https://newbornk.com/cdn/shop/files/Group_52.png?v=1778098458&width=1200",
        "width": 1200,
        "height": 1200
      },
      "image": "https://newbornk.com/cdn/shop/files/Group_52.png?v=1778098458&width=1200",
      "description": "Концепт-стор з унікальною селекцією одягу, взуття та аксесуарів від міжнародних та українських брендів.",
      "priceRange": "$$",
      "currenciesAccepted": "UAH",
      "paymentAccepted": "Visa, Mastercard, Apple Pay, Google Pay, LiqPay, Cash, Privat24",
      "numberOfEmployees": { "@type": "QuantitativeValue", "value": 5 },
      "telephone": "+380970443333",
      "email": "info@newbornk.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "вулиця Велика Житомирська, 20",
        "addressLocality": "Київ",
        "addressRegion": "Київська область",
        "postalCode": "01001",
        "addressCountry": "UA"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 50.4557,
        "longitude": 30.5123
      },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "11:00",
        "closes": "21:00"
      }],
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "+380970443333",
          "contactType": "customer service",
          "email": "info@newbornk.com",
          "areaServed": "UA",
          "availableLanguage": ["Ukrainian", "Russian", "English"]
        }
      ],
      "sameAs": [
        "https://www.facebook.com/newbornk.kyiv",
        "https://www.instagram.com/newborn.kyiv/",
        "https://www.youtube.com/@NEWBORNKYIV",
        "https://www.tiktok.com/@newborn_kyiv",
        "https://t.me/newbornkrew"
      ]
    }

    {%- comment -%} ========== BreadcrumbList (dynamic) ========== {%- endcomment -%}
    {%- unless template.name == 'index' or template.name == 'cart' or template.name == '404' or template.name == 'list-collections' -%}
    ,
    {
      "@type": "BreadcrumbList",
      "@id": {{ breadcrumb_id | json }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Головна",
          "item": {{ site_url | json }}
        }

        {%- case template.name -%}

          {%- when 'product' -%}
            {%- liquid
              assign bc_collection_title = ''
              assign bc_collection_url = ''
              if collection.url
                assign bc_collection_title = collection.title
                assign bc_collection_url = collection.url
              endif
              if product.metafields.brand.handle != blank
                assign bc_collection_title = collections[product.metafields.brand.handle].title
                assign bc_collection_url = collections[product.metafields.brand.handle].url
              endif
            -%}
            {%- if bc_collection_url != blank -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ bc_collection_title | json }},
              "item": {{ shop.url | append: bc_collection_url | json }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | json }},
              "item": {{ canonical_clean | json }}
            }
            {%- else -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | json }},
              "item": {{ canonical_clean | json }}
            }
            {%- endif -%}

          {%- when 'collection' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ canonical_clean | json }}
            }

          {%- when 'blog' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ canonical_clean | json }}
            }

          {%- when 'article' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ shop.url | append: blog.url | json }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ article.title | json }},
              "item": {{ canonical_clean | json }}
            }

          {%- when 'page' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ page.title | json }},
              "item": {{ canonical_clean | json }}
            }

          {%- else -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ page_title | json }},
              "item": {{ canonical_clean | json }}
            }

        {%- endcase -%}
      ]
    }
    {%- endunless -%}

    {%- comment -%} ========== Product + ProductGroup (product pages only) ========== {%- endcomment -%}
    {%- if template.name == 'product' and product != blank -%}
      {%- liquid
        assign product_id = canonical_clean | append: '#product'
        assign group_id = canonical_clean | append: '#product-group'
        assign brand_name = product.vendor | default: shop.name

        comment
          Detect color/size/material option positions
        endcomment
        assign color_value = ''
        assign size_value = ''
        assign material_value = ''
        assign size_option_index = 0
        assign color_option_index = -1
        assign material_option_index = -1
        for opt in product.options_with_values
          assign optname = opt.name | downcase
          assign first_val = opt.values | first
          if optname contains 'color' or optname contains 'colour' or optname contains 'колір' or optname contains 'цвет'
            assign color_value = first_val
            assign color_option_index = forloop.index0
          elsif optname contains 'size' or optname contains 'розмір' or optname contains 'размер'
            assign size_value = first_val
            assign size_option_index = forloop.index
          elsif optname contains 'material' or optname contains 'матеріал' or optname contains 'материал'
            assign material_value = first_val
            assign material_option_index = forloop.index0
          endif
        endfor

        assign taxonomy_material = ''
        for fabric in product.metafields.shopify.fabric.value
          assign fabric_label = fabric.label.value | strip
          if fabric_label != blank
            if taxonomy_material != blank
              assign taxonomy_material = taxonomy_material | append: ', '
            endif
            assign taxonomy_material = taxonomy_material | append: fabric_label
          endif
        endfor
        if taxonomy_material != blank and material_option_index == -1
          assign material_value = taxonomy_material
        endif

        assign gender_value = ''
        assign male_audience = false
        assign female_audience = false
        for target_gender in product.metafields.shopify['target-gender'].value
          assign gender_label = target_gender.label.value | downcase | strip
          case gender_label
            when 'unisex', 'унісекс', 'унисекс'
              assign gender_value = 'unisex'
              break
            when 'female', 'women', 'woman', 'жіночий', 'жіноча', 'жіночі', 'жіноче', 'жінки', 'женский', 'женская', 'женские', 'женщины'
              assign female_audience = true
            when 'male', 'men', 'man', 'чоловічий', 'чоловіча', 'чоловічі', 'чоловіче', 'чоловіки', 'мужской', 'мужская', 'мужские', 'мужчины'
              assign male_audience = true
          endcase
        endfor
        if gender_value == blank
          if female_audience and male_audience == false
            assign gender_value = 'female'
          elsif male_audience and female_audience == false
            assign gender_value = 'male'
          endif
        endif

        comment
          Judge.me rating from metafield (numeric "5.0", not Rating object)
        endcomment
        assign rating_value = product.metafields.reviews.rating.value
        assign rating_count = product.metafields.reviews.rating_count | plus: 0
      -%}

      {%- comment -%} Shared shipping + return policy fragment {%- endcomment -%}
      {%- capture shipping_return_json -%}
"shippingDetails": {
        "@type": "OfferShippingDetails",
        "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": "UAH" },
        "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "UA" },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
          "transitTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 3, "unitCode": "DAY" }
        }
      },
      "hasMerchantReturnPolicy": {
        "@type": "MerchantReturnPolicy",
        "applicableCountry": "UA",
        "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
        "merchantReturnDays": 14,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
      {%- endcapture -%}
    ,
    {
      "@type": "Product",
      "@id": {{ product_id | json }},
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | strip_newlines | strip | truncate: 5000 | json }},
      "url": {{ canonical_clean | json }}
      {%- if product.featured_image -%}
      ,"image": [
        {%- for media in product.media limit: 6 -%}
          {{ media | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
      {%- endif -%}
      ,"brand": { "@type": "Brand", "name": {{ brand_name | json }} },
      "sku": {{ product.selected_or_first_available_variant.sku | default: product.id | append: '' | json }},
      "mpn": {{ product.selected_or_first_available_variant.sku | default: product.id | append: '' | json }},
      "productID": {{ product.id | append: '' | json }}
      {%- if product.has_only_default_variant -%}
        {%- render 'nbk-jsonld-gtin', barcode: product.selected_or_first_available_variant.barcode -%}
      {%- endif -%}
      {%- if product.type != blank -%}
      ,"category": {{ product.type | json }}
      {%- endif -%}
      {%- if color_value != '' -%}
      ,"color": {{ color_value | json }}
      {%- endif -%}
      {%- if size_value != '' -%}
      ,"size": {{ size_value | json }}
      {%- endif -%}
      {%- if material_value != '' -%}
      ,"material": {{ material_value | json }}
      {%- endif -%}
      {%- if gender_value != '' -%}
      ,"audience": { "@type": "PeopleAudience", "suggestedGender": {{ gender_value | json }} }
      {%- endif -%}
      {%- if rating_value and rating_count > 0 -%}
      ,"aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{ rating_value }}",
        "reviewCount": {{ rating_count }},
        "bestRating": 5,
        "worstRating": 1
      }
      {%- endif -%}
      {%- if product.has_only_default_variant -%}
      ,"offers": {
        "@type": "Offer",
        "url": {{ canonical_clean | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.price | divided_by: 100.0 | json }},
        "availability": "{%- if product.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}",
        "itemCondition": "https://schema.org/NewCondition",
        "priceValidUntil": {{ price_until | json }},
        {{ shipping_return_json }},
        "seller": { "@id": {{ org_id | json }} }
      }
      {%- else -%}
      ,"isVariantOf": { "@id": {{ group_id | json }} },
      "offers": [
        {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          "url": {{ shop.url | append: variant.url | json }},
          "sku": {{ variant.sku | default: variant.id | append: '' | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "availability": "{%- if variant.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}",
          "itemCondition": "https://schema.org/NewCondition",
          "priceValidUntil": {{ price_until | json }},
          {{ shipping_return_json }},
          "seller": { "@id": {{ org_id | json }} }
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
      {%- endif -%}
    }
    {%- unless product.has_only_default_variant -%}
    ,
    {
      "@type": "ProductGroup",
      "@id": {{ group_id | json }},
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | strip_newlines | strip | truncate: 5000 | json }},
      "url": {{ canonical_clean | json }},
      "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
      "productGroupID": {{ product.id | append: '' | json }}
      {%- if product.type != blank -%}
      ,"category": {{ product.type | json }}
      {%- endif -%}
      {%- if material_value != '' and material_option_index == -1 -%}
      ,"material": {{ material_value | json }}
      {%- endif -%}
      {%- if gender_value != '' -%}
      ,"audience": { "@type": "PeopleAudience", "suggestedGender": {{ gender_value | json }} }
      {%- endif -%}
      {%- comment -%}
        aggregateRating intentionally lives ONLY on the main Product entity
        (#product) above — not here. Emitting it on both the Product and the
        ProductGroup makes Google Search Console flag "Review has multiple
        aggregate ratings" (invalid for rich results). Do not re-add it here.
      {%- endcomment -%}
      {%- if size_option_index > 0 or color_option_index > -1 or material_option_index > -1 -%}
      ,"variesBy": [
        {%- if size_option_index > 0 -%}"https://schema.org/size"{%- endif -%}
        {%- if color_option_index > -1 -%}
          {%- if size_option_index > 0 -%},{%- endif -%}"https://schema.org/color"
        {%- endif -%}
        {%- if material_option_index > -1 -%}
          {%- if size_option_index > 0 or color_option_index > -1 -%},{%- endif -%}"https://schema.org/material"
        {%- endif -%}
      ]
      {%- endif -%}
      ,"hasVariant": [
        {%- for variant in product.variants -%}
        {
          "@type": "Product",
          "sku": {{ variant.sku | default: variant.id | append: '' | json }},
          "name": {{ variant.title | json }},
          "description": {{ product.description | strip_html | strip_newlines | strip | truncate: 5000 | json }},
          "image": {{ variant.image | default: product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}
          {%- render 'nbk-jsonld-gtin', barcode: variant.barcode -%}
          {%- if color_option_index > -1 and variant.options[color_option_index] != blank -%}
          ,"color": {{ variant.options[color_option_index] | json }}
          {%- endif -%}
          {%- if material_option_index > -1 and variant.options[material_option_index] != blank -%}
          ,"material": {{ variant.options[material_option_index] | json }}
          {%- endif -%}
          {%- if size_option_index == 1 -%}
          ,"size": {{ variant.option1 | json }}
          {%- elsif size_option_index == 2 -%}
          ,"size": {{ variant.option2 | json }}
          {%- elsif size_option_index == 3 -%}
          ,"size": {{ variant.option3 | json }}
          {%- endif -%}
          ,"offers": {
            "@type": "Offer",
            "url": {{ shop.url | append: variant.url | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "availability": "{%- if variant.available -%}https://schema.org/InStock{%- else -%}https://schema.org/OutOfStock{%- endif -%}",
            "itemCondition": "https://schema.org/NewCondition",
            "priceValidUntil": {{ price_until | json }},
            {{ shipping_return_json }},
            "seller": { "@id": {{ org_id | json }} }
          }
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
    {%- endunless -%}
    {%- endif -%}

    {%- comment -%} ========== CollectionPage + ItemList (collection pages only) ========== {%- endcomment -%}
    {%- if template.name == 'collection' and collection != blank -%}
    {%- assign collection_page = current_page | default: 1 -%}
    ,
    {
      "@type": "CollectionPage",
      "@id": {{ canonical_clean | append: '#collectionpage' | json }},
      "name": {{ collection.title | json }},
      "description": {{ collection.description | default: collection.title | strip_html | strip_newlines | strip | truncate: 500 | json }},
      "url": {{ canonical_clean | json }},
      "isPartOf": { "@id": {{ website_id | json }} }
      {%- if collection_page == 1 and collection.products_count > 0 -%}
      {%- assign list_count = 0 -%}
      ,"mainEntity": {
        "@type": "ItemList",
        "name": {{ collection.title | json }},
        "itemListElement": [
          {%- for product in collection.products limit: 20 -%}
          {%- assign list_count = forloop.index -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "url": {{ shop.url | append: product.url | json }},
            "name": {{ product.title | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
        "numberOfItems": {{ list_count | default: 0 }}
      }
      {%- endif -%}
    }
    {%- endif -%}

    {%- comment -%} ========== Article / BlogPosting (article pages only) ========== {%- endcomment -%}
    {%- if template.name == 'article' and article != blank -%}
    ,
    {
      "@type": "BlogPosting",
      "@id": {{ canonical_clean | append: '#article' | json }},
      "headline": {{ article.title | json }},
      "description": {{ article.excerpt_or_content | strip_html | strip_newlines | strip | truncate: 500 | json }},
      "url": {{ canonical_clean | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | default: article.published_at | json }},
      "isPartOf": { "@id": {{ website_id | json }} }
      {%- if article.image -%}
      ,"image": {
        "@type": "ImageObject",
        "url": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
        "width": 1200,
        "height": {{ 1200 | divided_by: article.image.aspect_ratio | round }}
      }
      {%- endif -%}
      ,"author": {
        "@type": "Person",
        "name": {{ article.author | default: 'NEWBORN K' | json }}
      },
      "publisher": { "@id": {{ org_id | json }} },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ canonical_clean | json }}
      }
    }
    {%- endif -%}

  ]
}
</script>
