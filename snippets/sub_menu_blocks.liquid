{% doc %}
  Renders native dropdown links with an optional full-width desktop panel.
  @param {link} link - Existing menu item and its translated navigation links.
  @param {boolean} [wide_panel] - Match the full-width desktop mega-menu layout.
{% enddoc %}
{%- assign nbk_dropdown_count = 0 -%}
{%- capture nbk_dropdown_items -%}
  {%- for menu_page in (0..4) -%}
    {%- assign menu_offset = menu_page | times: 50 -%}
    {%- for childlink in link.links limit: 50 offset: menu_offset -%}
{%- capture nbk_childlink_state -%}{%- render 'nbk-menu-state', item: childlink -%}{%- endcapture -%}
{%- liquid
  assign nbk_childlink_state = nbk_childlink_state | strip | split: '|'
  assign nbk_childlink_children = nbk_childlink_state[0] | plus: 0
  if nbk_childlink_children == 0 and nbk_childlink_state[1] != '1'
    continue
  endif
  assign nbk_dropdown_count = nbk_dropdown_count | plus: 1
-%}
      {%- if nbk_childlink_children > 0 -%}
        <li>
          <hdt-accordion class="hdt-contents" only-click-icon>       
            <details class="hdt-menu-item hdt-flex hdt-justify-center hdt-flex-col{% if nbk_childlink_children > 0 %} hdt-has-children hdt-relative{% endif %}">
              <summary {% if nbk_childlink_state[1] == '1' %}data-url="{{ childlink.url }}"{% endif %} class="hdt-flex hdt-justify-between hdt-align-center hdt-relative" aria-expanded="false">
                {%- assign arr_title = childlink.title | remove: "[is_heading]" | split: '[' -%}
                {%- assign arr_label = arr_title[1] | split: ',' -%}
                <span class="hdt-menu-link-text hdt-block {%- if arr_label.size > 0 %} hdt-relative hdt-title_size-{{ arr_title[0].size | at_most: 20 }} hdt-has-{{ arr_label.size | at_most: 2 }}label{% endif %}">
                  <span class="hdt-block hdt-line-clamp">{{ arr_title[0] }}</span>
                  {%- if arr_label.size > 0 -%}
                    <span class="hdt_label_menu hdt-absolute hdt-inline-flex hdt-align-center hdt-justify-center hdt-text-xs">
                      {%- for label in arr_label limit: 2 -%}
                        {%- assign label_text = label | remove: 'label_' | remove: ','  | remove: ']' | strip -%}
                        <span class="hdt_label_{{ label_text | handleize }} hdt-flex hdt-align-center hdt-justify-center">{{ label_text }}</span>
                      {% endfor %}
                    </span>
                  {%- endif -%}
                </span>
                <span class="hdt-inline-flex hdt-align-center hdt-justify-center hdt-top-0 hdt-right-0 hdt-bottom-0 hdt-absolute" accordion-icon><svg class="hdt-menu-item-arrow" xmlns="http://www.w3.org/2000/svg" width="10" height="7" viewBox="0 0 10 7" fill="none"><path d="M10 1.24243L5 6.24243L-2.18557e-07 1.24243L0.8875 0.354932L5 4.46743L9.1125 0.354931L10 1.24243Z" fill="currentColor"/></svg></span>
              </summary>
                <div class="hdt-sub-menu hdt-sub-menu-child">
                  <ul class="hdt-menu-list hdt-sub-menu-lever-2" role="list">
                    {%- for grandchildlink in childlink.links -%}
{%- capture nbk_grandchildlink_state -%}{%- render 'nbk-menu-state', item: grandchildlink -%}{%- endcapture -%}
{%- liquid
  assign nbk_grandchildlink_state = nbk_grandchildlink_state | strip | split: '|'
  assign nbk_grandchildlink_children = nbk_grandchildlink_state[0] | plus: 0
  if nbk_grandchildlink_children == 0 and nbk_grandchildlink_state[1] != '1'
    continue
  endif
-%}
                      <li class="hdt-menu-item hdt-flex hdt-justify-center hdt-flex-col">
                        <a {% if nbk_grandchildlink_state[1] == '1' %}href="{{ grandchildlink.url }}"{% endif %} class="hdt-menu-link hdt-flex hdt-align-center hdt-justify-between hdt-relative hdt-text-base hdt-font-normal {% if grandchildlink.current %} hdt-menu-link--active{% endif %}" {% if grandchildlink.current %} aria-current="page" {% endif %}>
                          {%- assign arr_title = grandchildlink.title | remove: "[is_heading]" | split: '[' -%}
                          {%- assign arr_label = arr_title[1] | split: ',' -%}
                          <span class="hdt-menu-link-text hdt-block {%- if arr_label.size > 0 %} hdt-relative hdt-title_size-{{ arr_title[0].size | at_most: 20 }} hdt-has-{{ arr_label.size | at_most: 2 }}label{% endif %}">
                            <span class="hdt-block hdt-line-clamp">{{ arr_title[0] }}</span>
                            {%- if arr_label.size > 0 -%}
                              <span class="hdt_label_menu hdt-absolute hdt-inline-flex hdt-align-center hdt-justify-center hdt-text-xs">
                                {%- for label in arr_label limit: 2 -%}
                                  {%- assign label_text = label | remove: 'label_' | remove: ','  | remove: ']' | strip -%}
                                  <span class="hdt_label_{{ label_text | handleize }} hdt-flex hdt-align-center hdt-justify-center">{{ label_text }}</span>
                                {% endfor %}
                              </span>
                            {%- endif -%}
                          </span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
            </details>
          </hdt-accordion>        
        </li>
      {% else %}
        <li class="hdt-menu-item hdt-flex hdt-justify-start hdt-align-center">
          <a {% if nbk_childlink_state[1] == '1' %}href="{{ childlink.url }}"{% endif %} class="hdt-menu-link hdt-flex hdt-align-center hdt-justify-between hdt-relative hdt-text-base hdt-font-normal {% if childlink.current %} hdt-menu-link--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
            {%- assign arr_title = childlink.title | remove: "[is_heading]" | split: '[' -%}
            {%- assign arr_label = arr_title[1] | split: ',' -%}
            <span class="hdt-menu-link-text hdt-block {%- if arr_label.size > 0 %} hdt-relative hdt-title_size-{{ arr_title[0].size | at_most: 20 }} hdt-has-{{ arr_label.size | at_most: 2 }}label{% endif %}">
              <span class="hdt-block hdt-line-clamp">{{ arr_title[0] }}</span>
              {%- if arr_label.size > 0 -%}
                <span class="hdt_label_menu hdt-absolute hdt-inline-flex hdt-align-center hdt-justify-center hdt-text-xs">
                  {%- for label in arr_label limit: 2 -%}
                    {%- assign label_text = label | remove: 'label_' | remove: ','  | remove: ']' | strip -%}
                    <span class="hdt_label_{{ label_text | handleize }} hdt-flex hdt-align-center hdt-justify-center">{{ label_text }}</span>
                  {% endfor %}
                </span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {% endif %}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- liquid
  assign nbk_dropdown_columns = nbk_dropdown_count | at_least: 1 | at_most: 4
  if nbk_dropdown_count > 30
    assign nbk_dropdown_columns = 4
  elsif nbk_dropdown_count > 20
    assign nbk_dropdown_columns = 3
  elsif nbk_dropdown_count > 10
    assign nbk_dropdown_columns = 2
  endif
-%}
<div class="hdt-sub-menu hdt-absolute hdt-dropdown-menu{% if wide_panel %} nbk-dropdown-panel{% if nbk_dropdown_count <= 10 %} nbk-dropdown-panel--short{% endif %}{% endif %}" color-scheme="{{ section.settings.header_menu_colors }}"{% if wide_panel %} style="--nbk-dropdown-columns: {{ nbk_dropdown_columns }};"{% endif %}>
  {%- if wide_panel -%}
    <div class="nbk-dropdown-inner">
      <h3 class="nbk-dropdown-title">{{ link.title | remove: '[is_heading]' | split: '[' | first | escape }}</h3>
    {%- endif -%}
    <ul class="hdt-menu-list hdt-sub-menu-lever-1" role="list">{{ nbk_dropdown_items }}</ul>
  {%- if wide_panel -%}</div>{%- endif -%}
</div>
{% stylesheet %}
@media (min-width: 1150px) {
  #hdt-nav-ul > li > hdt-header-menu > details > .nbk-dropdown-panel {
    inset-inline: 0;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    max-height: calc(100dvh - var(--header-height, 100px) - var(--top-bar-height, 0px) - 24px);
    padding: 32px clamp(24px, 3vw, 60px) 36px;
    background: #fff;
    --color-foreground: 17 17 17;
    --color-foreground2: 17 17 17;
    --color-accent: 17 17 17;
    color: #111;
    border: 0;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #e5e5e5;
    border-radius: 0;
    box-shadow: none;
  }
  #hdt-nav-ul .nbk-dropdown-inner {
    max-width: 1500px;
    margin-inline: auto;
    font-family: 'Formular', sans-serif;
  }
  #hdt-nav-ul .nbk-dropdown-title {
    margin: 0 0 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid #dedede;
    font: 400 16px/1.4 'Formular', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0;
  }
  #hdt-nav-ul .nbk-dropdown-panel .hdt-sub-menu-lever-1 {
    display: block;
    columns: var(--nbk-dropdown-columns);
    column-gap: clamp(28px, 4vw, 64px);
    margin: 0;
    padding: 0;
  }
  #hdt-nav-ul .nbk-dropdown-panel--short .hdt-sub-menu-lever-1 {
    display: grid;
    grid-template-columns: repeat(var(--nbk-dropdown-columns), minmax(0, 1fr));
    align-items: start;
    columns: auto;
    row-gap: 4px;
  }
  #hdt-nav-ul .nbk-dropdown-panel .hdt-sub-menu-lever-1 > li {
    break-inside: avoid;
    margin: 0;
    padding: 0;
  }
  #hdt-nav-ul .nbk-dropdown-panel :is(.hdt-menu-link, summary) {
    min-height: 40px;
    padding: 9px 0;
    font: 400 16px/1.4 'Formular', sans-serif;
    color: #111;
    text-transform: uppercase;
    letter-spacing: 0;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  #hdt-nav-ul .nbk-dropdown-panel summary {
    padding-inline-end: 24px;
  }
  #hdt-nav-ul .nbk-dropdown-panel .hdt-menu-link-text {
    min-width: 0;
    max-width: 100%;
  }
  #hdt-nav-ul .nbk-dropdown-panel .hdt-line-clamp {
    display: block;
    overflow: visible;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  #hdt-nav-ul .nbk-dropdown-panel :is(a, summary):is(:hover, :focus-visible) {
    color: #111;
    text-decoration: underline;
  }
  #hdt-nav-ul .nbk-dropdown-panel :is(a, summary):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 0;
  }
  #hdt-nav-ul .nbk-dropdown-panel .hdt-sub-menu-child {
    margin: 4px 0 12px;
    padding: 0 0 0 16px;
    border-inline-start: 1px solid #dedede;
    background: transparent;
  }
  #hdt-nav-ul .nbk-dropdown-panel .hdt-sub-menu-lever-2 {
    gap: 0;
  }
}
{% endstylesheet %}
