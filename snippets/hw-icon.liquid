{%- comment -%}
  Halloween landing icons. Usage: {% render 'hw-icon', icon: 'web', size: 300 %}
  icons: web, spider, pumpkin, pin, star
{%- endcomment -%}
{%- case icon -%}
  {%- when 'web' -%}
    <svg viewBox="0 0 270 270" width="{{ size | default: 300 }}" height="{{ size | default: 300 }}" aria-hidden="true" focusable="false"><path d="M0 0L270 0M0 0L261 70M0 0L229 143M0 0L166 213M0 0L83 257M0 0L0 270M55 0Q48 6 53 14Q44 19 47 29Q35 32 34 43Q22 42 17 52Q7 47 0 55M105 0Q91 12 101 27Q84 36 89 56Q68 61 65 83Q43 80 32 100Q14 90 0 105M160 0Q138 18 155 41Q128 56 136 85Q103 93 99 126Q65 122 49 152Q22 137 0 160M215 0Q186 24 208 56Q172 75 182 114Q138 125 132 169Q87 165 66 204Q29 185 0 215"/></svg>
  {%- when 'spider' -%}
    <svg viewBox="0 0 40 34" width="{{ size | default: 40 }}" height="{{ size | default: 40 | times: 0.85 | round }}" aria-hidden="true" focusable="false"><path d="M14 14L4 5M14 17L1 16M14 20L4 28M15 23L9 33M26 14L36 5M26 17L39 16M26 20L36 28M25 23L31 33"/><ellipse cx="20" cy="20" rx="7" ry="8"/><circle cx="20" cy="8" r="6.3"/><g class="hw-eyes"><circle cx="17.3" cy="8.2" r="2.6"/><circle cx="22.7" cy="8.2" r="2.6"/><circle class="hw-eyes__p" cx="17.8" cy="8.6" r="1.3"/><circle class="hw-eyes__p" cx="23.2" cy="8.6" r="1.3"/></g></svg>
  {%- when 'spider-dark' -%}
    <svg viewBox="0 0 40 34" width="22" height="19" aria-hidden="true" focusable="false"><path d="M14 14L4 5M14 17L1 16M14 20L4 28M15 23L9 33M26 14L36 5M26 17L39 16M26 20L36 28M25 23L31 33" stroke="#000" stroke-width="2" fill="none" stroke-linecap="round"/><ellipse cx="20" cy="20" rx="7" ry="8" fill="#000"/><circle cx="20" cy="8" r="6.3" fill="#000"/><g class="hw-eyes"><circle cx="17.3" cy="8.2" r="2.6" fill="#fff"/><circle cx="22.7" cy="8.2" r="2.6" fill="#fff"/><circle cx="17.8" cy="8.6" r="1.3" fill="#000"/><circle cx="23.2" cy="8.6" r="1.3" fill="#000"/></g></svg>
  {%- when 'pumpkin' -%}
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><ellipse cx="8" cy="14.5" rx="5.5" ry="7" fill="#FF6A1A"/><ellipse cx="16" cy="14.5" rx="5.5" ry="7" fill="#FF6A1A"/><ellipse cx="12" cy="14.5" rx="4.5" ry="7.5" fill="#FF8A3D"/><path d="M12 7.5c0-2 .8-3.6 2.6-4.5" stroke="#2B2B2B" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
  {%- when 'pin' -%}
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false" fill="none" stroke="#000" stroke-width="2"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" width="{{ size | default: 16 }}" height="{{ size | default: 16 }}" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z"/></svg>
{%- endcase -%}
