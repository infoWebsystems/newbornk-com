{% doc %}
  Resolve a product vendor through the shared brand menu, retaining native fallback.
  @param {string} vendor - Product vendor, including its original spelling.
{% enddoc %}
{%- liquid
  assign vendor_key = vendor | remove: '🇺🇦' | strip | handleize
  assign brand_url = ''
  assign brand_links = linklists['brands-menu'].links
  assign brand_batches = brand_links.size | minus: 1 | divided_by: 50
  for batch in (0..brand_batches)
    assign brand_offset = batch | times: 50
    for brand_link in brand_links limit: 50 offset: brand_offset
      capture brand_label
        render 'nbk-brand-label', link: brand_link
      endcapture
      assign brand_key = brand_label | remove: '🇺🇦' | strip | handleize
      if brand_key == vendor_key and brand_link.type == 'collection_link' and brand_link.object.url != blank
        assign brand_url = brand_link.object.url
        break
      endif
    endfor
    if brand_url != blank
      break
    endif
  endfor
  if brand_url == blank and collections[vendor_key] != blank
    assign brand_url = collections[vendor_key].url
  endif
  if brand_url != blank
    echo brand_url
  else
    echo vendor | url_for_vendor
  endif
-%}
