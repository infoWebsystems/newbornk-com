<nav
  class="header__inline-menu header__inline-menu--mobile"
  {%- if section.settings.menu_position == 'center' -%}
  style="margin: auto;"
  {%- endif -%}>
  <div class="facets-box__icon--close">
    {%- render 'icon-close' -%}
  </div>
  <ul class="list-menu list-menu--inline sidebar-menu" role="list">
