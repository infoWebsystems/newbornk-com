              {% assign ct_tag_tag = ct_tag | last %}
              {% assign ct_tag_tag_downcase = ct_tag_tag | downcase %}
              {% if cur_tags contains ct_tag_tag or cur_tags contains ct_tag_tag_downcase %}
              {% else %}
                {% continue %}
              {% endif %}
              {%- unless ct_tag_collection contains cur_tags -%}
