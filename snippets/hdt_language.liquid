{% doc %}
  Displays the Kyiv globe control for the native Kalles language popover.
  @param {boolean} [mobile] - Use the mobile popover presentation.
{% enddoc %}
<div data-locale-wrap class="hdt-languages nbk-language-globe hdt-inline-block">
  <button type="button" aria-controls="popover-languages" aria-label="{{ 'nbk.language_label' | t | escape }}: {{ request.locale.endonym_name | escape }}"{% if mobile %} data-popover-active-min-width="10000"{% endif %}>
    <svg class="nbk-globe" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg>
  </button>
</div>
{% stylesheet %}
.nbk-language-globe > button {width:44px; height:44px; justify-content:center; padding:10px;}
.nbk-language-globe > button .nbk-globe {width:24px; height:24px; margin:0; flex-shrink:0;}
.nbk-language-globe > button:focus-visible {outline:2px solid currentColor; outline-offset:2px;}
{% endstylesheet %}
