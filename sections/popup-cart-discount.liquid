{% assign show_popup-discount = section.settings.show_popup-discount %}
{% assign title = section.settings.title %}
{% assign text = section.settings.text %}
{% assign logo = section.settings.logo %}

{{ 'popup-cart-discount.css' | asset_url | stylesheet_tag }}

{% if show_popup-discount %}
    <div class="popup-discount show" id="popup-discount">
        <div class="popup-discount__container">
            <div class="popup-discount__body">
                <div class="popup-discount__close">
                    {% render 'svg', name: 'close-popup' %}
                </div>
                <div class="popup-discount__logo">
                    {% if logo != blank %}<img src="{{ logo | img_url: 'master' }}" alt="logo newborn">{% endif %}
                </div>
                <div class="popup-discount__heading">
                    {{ title }}
                </div>
                <div class="popup-discount__message">
                    <div class="popup-discount__text">
                        {{ text }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}

<script src='{{ 'popup-cart-discount.js' | asset_url }}' ></script>

{% schema %}
{
  "name": "Popup cart discount",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_popup-discount",
      "label": "Show popup discount",
      "default": true
    },{
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Дякуємо що скористалися промо-кодом!"
    },{
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Ваша знижка буде автоматично додана в кошику при оформленні замовлення."
    },{
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    }
  ],
  "presets": [
    {
      "name": "Popup cart discount"
    }
  ]
}
{% endschema %}
