{{ 'section-halloween-v2.css' | asset_url | stylesheet_tag }}

<section class="hw hw-cta">
  <div class="hw-wrap hw-cta__row">
    <h2 class="hw-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.button_label != blank -%}
      <a class="hw-btn hw-btn--dark" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "HW2 · CTA",
  "tag": "div",
  "class": "section-halloween-cta",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Заголовок", "default": "Halloween — гарний привід оновити гардероб" },
    { "type": "text", "id": "button_label", "label": "Кнопка", "default": "До розпродажу" },
    { "type": "url", "id": "button_link", "label": "Посилання кнопки" }
  ],
  "presets": [{ "name": "HW2 · CTA" }]
}
{% endschema %}
