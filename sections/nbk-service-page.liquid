{%- liquid
  assign service_title = page.title
  if request.locale.iso_code == 'uk' or request.locale.iso_code == 'en' or request.locale.iso_code == 'ru'
    case page.handle
      when 'order-and-delivery'
        assign service_title = 'nbk_contact.delivery' | t
      when 'return'
        assign service_title = 'nbk_contact.returns' | t
    endcase
  endif
-%}
{%- if page.handle == 'newborn-krew' -%}
  {{ 'nbk-policy.css' | asset_url | stylesheet_tag }}
  {{ 'nbk-krew-page.css' | asset_url | stylesheet_tag }}
{%- endif -%}
<article class="nbk-service-page" aria-labelledby="nbk-service-title">
  <header class="nbk-service-page__header">
    <h1 id="nbk-service-title">{{ service_title | escape }}</h1>
  </header>
  {% if page.handle == 'return' %}
    <aside class="nbk-service-help">
      <a class="nbk-service-help__action" href="{{ pages['contact'].url }}#ContactForm">{{ 'nbk_footer.return_action' | t }}</a>
      <p>{{ 'nbk_footer.return_hint' | t }}</p>
    </aside>
  {% endif %}
  <div class="nbk-service-page__body">
    {% if page.handle == 'newborn-krew' %}
      {{ page.content }}
    {% else %}
      {% render 'nbk-service-content', content: page.content, page_body: true, handle: page.handle %}
    {% endif %}
  </div>
</article>
{% schema %}
{
  "name": "Information page",
  "tag": "section",
  "settings": []
}
{% endschema %}
