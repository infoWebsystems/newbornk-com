{% comment %} On the homepage this section is above the fold: its CSS must apply at first
paint or the cards/title take their final geometry late and shift the layout (CLS).
Elsewhere (e.g. product pages) the section is below the fold and deferred loading wins. {% endcomment %}
{%- if request.page_type == 'index' -%}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-badge.css' | asset_url | stylesheet_tag }}
  {{ 'template-collection.css' | asset_url | stylesheet_tag }}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'section-collection-slider.css' | asset_url | stylesheet_tag }}
{%- else -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'" />
  <link rel="stylesheet" href="{{ 'component-badge.css' | asset_url }}" media="print" onload="this.media='all'" />
  <link rel="stylesheet" href="{{ 'template-collection.css' | asset_url }}" media="print" onload="this.media='all'" />
  <link rel="stylesheet" href="{{ 'component-card.css' | asset_url }}" media="print" onload="this.media='all'" />
  <link rel="stylesheet" href="{{ 'section-collection-slider.css' | asset_url }}" media="print" onload="this.media='all'" />
{%- endif -%}
<style>
  .swiper-container-collection.section-{{section.id}}:not(.swiper-container-initialized) .swiper-wrapper { display: flex; overflow: hidden; }
  .swiper-container-collection.section-{{section.id}}:not(.swiper-container-initialized) .swiper-slide { flex: 0 0 calc(100% / {{ section.settings.products_to_show | default: 7 }}); }
  @media (max-width: 639px) { .swiper-container-collection.section-{{section.id}}:not(.swiper-container-initialized) .swiper-slide { flex: 0 0 calc(100% / {{ section.settings.products_to_show_mobile | default: 2 }}); } }
</style>

{%- unless request.page_type == 'index' -%}
  <noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>
  <noscript>{{ 'component-badge.css' | asset_url | stylesheet_tag }}</noscript>
  <noscript>{{ 'template-collection.css' | asset_url | stylesheet_tag }}</noscript>
  <noscript>{{ 'component-card.css' | asset_url | stylesheet_tag }}</noscript>
  <noscript>{{ 'section-collection-slider.css' | asset_url | stylesheet_tag }}</noscript>
{%- endunless -%}

{%- assign products = section.settings.collection.products -%}
{%- assign title = section.settings.title | escape -%}
{%- assign url = section.settings.collection.url -%}
{% assign featured_collection_metafield = product.metafields.custom.featured_collection.value %}

{% if section.settings.brand_collection == true %}
  {%- if template contains 'product' -%}

    {%- assign handle = product.vendor | downcase | handle -%}
    {% assign collection_vendor = collections[handle] %}

    {%- if handle != blank and collection_vendor != blank and collection_vendor.all_products_count > 5 -%}
      {%- assign collection = collections[handle] -%}
      {%- assign products = collection.all_products -%}
      {%- assign title = collection.title | escape -%}
      {%- assign url = collection.url -%}
    {% elsif featured_collection_metafield != blank and featured_collection_metafield.all_products_count > 5 %}
      {%- assign collection = featured_collection_metafield -%}
      {%- assign products = collection.all_products -%}
      {%- assign title = collection.title | escape -%}
      {%- assign url = collection.url -%}
    {%- endif -%}

  {%- endif -%}
{% endif %}


  {% assign new_products = null | sort %}
  {% for item in products %}
    {% assign tags = item.tags | join: ', ' %}
    {% unless template contains 'outlet' %}
      {% unless tags contains 'Outlet' %}
        {% assign prod = item | sort %}
        {% assign new_products = new_products | concat: prod %}
      {% endunless %}
    {% else %}
      {% if tags contains 'Outlet' %}
        {% assign prod = item | sort %}
        {% assign new_products = new_products | concat: prod %}
      {% endif %}
    {% endunless %}
  {% endfor %}
  {% for it in new_products %}
    {% assign length = forloop.length %}
  {% endfor %}


{% javascript %}
  var menu = [];
{% endjavascript %}

{% if new_products != blank and length > 5 %}
  <div class="collection handle-{{handle}} page-width{% if section.settings.swipe_on_mobile == true and section.settings.collection.all_products_count > 2 and section.settings.products_to_show > 2 and false %} page-width-desktop{% endif %} page-width-full">
    <div class="{% if section.settings.show_view_all and section.settings.swipe_on_mobile %}title-wrapper-with-link{% endif %}{% if section.settings.title == blank %} title-wrapper-with-link--no-heading{% endif %}{% if section.settings.collection.all_products_count > 2 and section.settings.swipe_on_mobile and section.settings.products_to_show > 2 %} title-wrapper--self-padded-tablet-down{% endif %}">
      <h2 class="title{% if title == blank %} title--no-heading{% endif %}">
        <a href="{{ url }}">{% if section.settings.show_text %} {{ 'templates.collection.slider.title' | t }}{% endif %}  {{ title }}
          {%- if section.settings.show_arrow %}{% render 'icon-caret' %} {% endif %}
        </a>
      </h2>

      {%- if section.settings.show_view_all and section.settings.swipe_on_mobile -%}
        <a href="{{ url }}" class="link underlined-link large-up-hide">{{ 'sections.featured_collection.view_all' | t }}</a>
      {%- endif -%}
    </div>

    {%- liquid
      assign products_to_display = section.settings.collection.all_products_count

      if section.settings.collection.all_products_count > section.settings.products_to_show
        assign products_to_display = section.settings.products_to_show
      endif
    %}

    <div class="swiper-container swiper-container-collection section-{{section.id}}" >
      {%- comment -%} div, not ul[role=list]: Swiper's a11y module sets role="group" on
      slides at init, which violates the required children of a list (axe:
      aria-required-children) {%- endcomment -%}
      <div class="swiper-wrapper">
        {%- for product in new_products -%}
          <div class="swiper-slide">
                {% render 'product-card',
                    product_card_product: product,
                    media_size: section.settings.image_ratio,
                    show_secondary_image: section.settings.show_secondary_image,
                    add_image_padding: section.settings.add_image_padding,
                    show_vendor: section.settings.show_vendor,
                    show_info: true
            %}
          </div>
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="grid__item">
              {% render 'product-card-placeholder' %}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.show_view_all and section.settings.collection.all_products_count > section.settings.products_to_show -%}
      <div class="center{% if section.settings.swipe_on_mobile %} small-hide medium-hide{% endif %}" style="margin-top: 2em;">
        <a href="{{ url }}"
           class="button"
           aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: title }}"
        >
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
  <style>
    .swiper-container-collection {
      overflow: hidden;
    }
  </style>
  {% assign product_show = section.settings.products_to_show | times:1.0 %}
  {% assign product_show_mobile = section.settings.products_to_show_mobile | times:1.0 %}
  {% assign slider_id = section.id | remove: '-' | remove: '_' %}

  <script type="text/javascript" defer>
    (function waitForSwiper() {
      if (typeof Swiper === 'undefined') {
        // Check again in 50ms
        setTimeout(waitForSwiper, 50);
        return;
      }

      // Swiper is loaded, initialize
      const swiper{{slider_id}} = new Swiper('.swiper-container-collection.section-{{section.id}}', {
        slidesPerView: {{ product_show }},
        speed: 100,
        centeredSlides: false,
        touchRatio: 1,
        slideToClickedSlide: false,
        cssMode: false,
        freeMode: true,
        slidesOffsetAfter: 0,
        mousewheel: {
          releaseOnEdges: true,
        },
        breakpoints: {
          320: {
            slidesPerView: {{ product_show_mobile }}
          },
          480: {
            slidesPerView: {{ product_show_mobile }}
          },
          640: {
            slidesPerView: {{ product_show }}
          }
        }
      });
    })();
  </script>

{% endif %}
{% schema %}
{
  "name":"t:sections.featured-collection-slider.name",
  "tag":"section",
  "class":"spaced-section collection-slider",
  "settings":[
    {
      "type":"text",
      "id":"title",
      "default":"Title",
      "label":"t:sections.featured-collection-slider.settings.title.label"
    },
    {
      "type":"checkbox",
      "id":"show_text",
      "default":true,
      "label":"Show text 'ALL PRODUCTS FROM'"
    },
    {
      "type":"collection",
      "id":"collection",
      "label":"t:sections.featured-collection-slider.settings.collection.label"
    },
    {
      "type":"range",
      "id":"products_to_show",
      "min":2,
      "max":12,
      "step":0.5,
      "default":6.5,
      "label":"t:sections.featured-collection-slider.settings.products_to_show.label"
    },
    {
      "type":"range",
      "id":"products_to_show_mobile",
      "min":1,
      "max":2,
      "step":0.1,
      "default":1.5,
      "label":"Maximum products to show mobile"
    },
    {
      "type":"checkbox",
      "id":"show_view_all",
      "default":true,
      "label":"t:sections.featured-collection-slider.settings.show_view_all.label"
    },
    {
      "type":"checkbox",
      "id":"swipe_on_mobile",
      "default":false,
      "label":"t:sections.featured-collection-slider.settings.swipe_on_mobile.label"
    },
    {
      "type":"header",
      "content":"t:sections.featured-collection-slider.settings.header.content"
    },
    {
      "type":"select",
      "id":"image_ratio",
      "options":[
        {
          "value":"adapt",
          "label":"t:sections.featured-collection-slider.settings.image_ratio.options__1.label"
        },
        {
          "value":"portrait",
          "label":"t:sections.featured-collection-slider.settings.image_ratio.options__2.label"
        },
        {
          "value":"square",
          "label":"t:sections.featured-collection-slider.settings.image_ratio.options__3.label"
        }
      ],
      "default":"adapt",
      "label":"t:sections.featured-collection-slider.settings.image_ratio.label"
    },
    {
      "type":"checkbox",
      "id":"show_secondary_image",
      "default":false,
      "label":"t:sections.featured-collection-slider.settings.show_secondary_image.label"
    },
    {
      "type":"checkbox",
      "id":"add_image_padding",
      "default":false,
      "label":"t:sections.featured-collection-slider.settings.add_image_padding.label"
    },
    {
      "type":"checkbox",
      "id":"show_vendor",
      "default":false,
      "label":"t:sections.featured-collection-slider.settings.show_vendor.label"
    },
    {
      "type":"checkbox",
      "id":"show_arrow",
      "default":false,
      "label":"Show Arrow After Link"
    },
    {
      "type":"checkbox",
      "id":"brand_collection",
      "default":false,
      "label":"Show product brand collection"
    }
  ],
  "presets":[
    {
      "name":"t:sections.featured-collection-slider.presets.name"
    }
  ]
}
{% endschema %}
