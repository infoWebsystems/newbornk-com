<section class="nbk-brand-directory" aria-labelledby="BrandHeading-{{ section.id }}">
  <div class="hdt-container">
    <h2 id="BrandHeading-{{ section.id }}" class="nbk-brand-directory__heading">{{ 'nbk_home.featured_brands' | t }}</h2>
    <hdt-slider id="Slider-{{ section.id }}" class="hdt-slider hdt-relative hdt-slides-2 md:hdt-slides-3 lg:hdt-slides-6" config='{ "id": "Slider-{{ section.id }}", "navUI": true, "dotUI": true, "loop": false, "autoPlay": 0 }'>
      <div class="hdt-slider__viewport">
        <div class="hdt-slider__container">
          {%- for block in section.blocks -%}
            {%- assign brand = block.settings.collection -%}
            {%- if brand != blank and brand.all_products_count > 0 -%}
              <div class="hdt-slider__slide" {{ block.shopify_attributes }}>
                <a class="nbk-brand-directory__link" href="{{ brand.url }}" calc-nav>
                  {%- if block.settings.logo != blank -%}
                    {{ block.settings.logo | image_url: width: 400 | image_tag: widths: '160, 240, 400', sizes: '(min-width: 1150px) 180px, (min-width: 768px) 220px, 45vw', loading: 'lazy', alt: brand.title }}
                  {%- else -%}
                    <span>{{ brand.title | escape }}</span>
                  {%- endif -%}
                </a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      <div class="nbk-brand-directory__controls">
        <button class="hdt-slider__button hdt-slider__button--prev" type="button" name="previous" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'nbk_home.previous_brands' | t | escape }}" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m14 6-6 6 6 6"/></svg>
        </button>
        <div hdt-slider-dots aria-controls="Slider-{{ section.id }}" class="hdt-slider__dots hdt-pagination hdt-style-elessi hdt-radius-true" style="--space-between: 10px; --margin-top: 0px;"></div>
        <button class="hdt-slider__button hdt-slider__button--next" type="button" name="next" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'nbk_home.next_brands' | t | escape }}" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m10 6 6 6-6 6"/></svg>
        </button>
      </div>
    </hdt-slider>
    <a class="nbk-brand-directory__all" href="{{ collections['brands'].url }}">{{ 'nbk_home.all_brands' | t }} <span aria-hidden="true">→</span></a>
  </div>
</section>

{% stylesheet %}
  .nbk-brand-directory {
    padding-block: 56px;
    margin-bottom: 50px;
    background: #f6f6f8;
    color: #000;
  }
  .nbk-brand-directory__heading {
    margin: 0 0 24px;
    font-size: 26px;
    line-height: 1.25;
    font-weight: 400;
  }
  .nbk-brand-directory .hdt-slider {
    --slide-spacing: 20px;
  }
  .nbk-brand-directory__link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 110px;
    padding: 16px 10px;
    color: inherit;
    font-size: 20px;
    line-height: 1.25;
    font-weight: 700;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .nbk-brand-directory__link:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .nbk-brand-directory__link img {
    width: 100%;
    max-height: 78px;
    object-fit: contain;
  }
  .nbk-brand-directory__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
  }
  .nbk-brand-directory__controls > .hdt-slider__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 8px;
    color: inherit;
    position: static;
    transform: none;
  }
  .nbk-brand-directory__controls > .hdt-slider__button:disabled {
    opacity: .3;
  }
  .nbk-brand-directory .hdt-slider .hdt-pagination button.hdt-slider__dot {
    background-color: #000;
    border-color: #000;
  }
  .nbk-brand-directory__all {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin: 24px auto 0;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .nbk-brand-directory__all:focus-visible,
  .nbk-brand-directory__link:focus-visible,
  .nbk-brand-directory__controls button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }
  @media (max-width: 767px) {
    .nbk-brand-directory {
      padding-block: 32px;
      margin-bottom: 30px;
    }
    .nbk-brand-directory__link {
      min-height: 96px;
      font-size: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kyiv brand directory",
  "max_blocks": 20,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Brand collection" },
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "The collection title appears when no logo is selected." }
      ]
    }
  ],
  "presets": [{ "name": "Kyiv brand directory" }]
}
{% endschema %}
