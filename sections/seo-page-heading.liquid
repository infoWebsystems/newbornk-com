<div class="hdt-container nbk-page-heading"><h1>{{ page.title | escape }}</h1></div>
{% stylesheet %}
.nbk-page-heading {max-width: 950px; padding: 40px 25px 24px;}
.nbk-page-heading h1 {font-size: 32px; line-height: 1.3; margin: 0;}
@media(max-width:749px) {.nbk-page-heading {padding: 28px 15px 20px;} .nbk-page-heading h1 {font-size: 26px;}}
{% endstylesheet %}
