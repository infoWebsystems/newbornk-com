{{ 'section-halloween.css' | asset_url | stylesheet_tag }}

<section class="hw hw-hero">
  {%- if section.settings.image != blank -%}
    <div class="hw-hero__photo">
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 760px) 64vw, 100vw', widths: '750, 1100, 1500, 2000', alt: section.settings.image.alt }}
    </div>
  {%- endif -%}

  {%- if section.settings.show_decor -%}
    <div class="hw-web hw-web--l" aria-hidden="true">{% render 'hw-icon', icon: 'web', size: 300 %}</div>
    <div class="hw-web hw-web--r" aria-hidden="true">{% render 'hw-icon', icon: 'web', size: 240 %}</div>
    <div class="hw-spider hw-hide-m" style="left: 60%;" aria-hidden="true"><span class="hw-spider__thread" style="height: 170px;"></span>{% render 'hw-icon', icon: 'spider', size: 54 %}</div>
    <div class="hw-spider hw-hide-m" style="left: 76%; animation-duration: 3.4s; animation-delay: -1.2s;" aria-hidden="true"><span class="hw-spider__thread" style="height: 80px; animation-duration: 5.8s;"></span>{% render 'hw-icon', icon: 'spider', size: 38 %}</div>
    <div class="hw-spider" style="left: 88%; animation-duration: 5s; animation-delay: -2.5s;" aria-hidden="true"><span class="hw-spider__thread" style="height: 250px; animation-duration: 8.5s;"></span>{% render 'hw-icon', icon: 'spider', size: 46 %}</div>
  {%- endif -%}

  <div class="hw-wrap hw-hero__content">
    {%- if section.settings.eyebrow != blank -%}<p class="hw-hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="hw-h1">{{ section.settings.heading | newline_to_br }}</h1>
    {%- if section.settings.text != blank -%}<p class="hw-hero__text">{{ section.settings.text }}</p>{%- endif -%}
    <div class="hw-hero__buttons">
      {%- if section.settings.button_1_label != blank -%}
        <a class="hw-btn hw-btn--accent" href="{{ section.settings.button_1_link | default: '#' }}">{{ section.settings.button_1_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a class="hw-btn hw-btn--ghost" href="{{ section.settings.button_2_link | default: '#' }}">{{ section.settings.button_2_label }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.address_line_1 != blank -%}
    <a class="hw-addr" href="{{ section.settings.address_link | default: '#' }}" target="_blank" rel="noopener">
      <span class="hw-addr__pin">{% render 'hw-icon', icon: 'pin' %}</span>
      <span class="hw-addr__lines">
        <span class="hw-addr__l1">{{ section.settings.address_line_1 }}</span>
        {%- if section.settings.address_line_2 != blank -%}<span class="hw-addr__l2">{{ section.settings.address_line_2 }}</span>{%- endif -%}
      </span>
      <span aria-hidden="true">→</span>
    </a>
  {%- endif -%}

  <div class="hw-fade-down" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "Halloween · Hero",
  "tag": "div",
  "class": "section-halloween-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Фото магазину (справа, з градієнтом)" },
    { "type": "checkbox", "id": "show_decor", "label": "Павутина й павуки", "default": true },
    { "type": "color", "id": "accent", "label": "Акцент", "default": "#CCF951" },
    { "type": "text", "id": "eyebrow", "label": "Надзаголовок", "default": "Halloween у NEWBORN K · 31.10" },
    { "type": "textarea", "id": "heading", "label": "Заголовок", "default": "Страшно\nвигідно" },
    { "type": "textarea", "id": "text", "label": "Текст", "default": "Знижки до −80% на розпродаж, бренди, за якими до нас приходять, і свіжі надходження сезону." },
    { "type": "text", "id": "button_1_label", "label": "Кнопка 1", "default": "Дивитися sale" },
    { "type": "url", "id": "button_1_link", "label": "Посилання кнопки 1" },
    { "type": "text", "id": "button_2_label", "label": "Кнопка 2", "default": "Новинки" },
    { "type": "url", "id": "button_2_link", "label": "Посилання кнопки 2" },
    { "type": "header", "content": "Плашка з адресою" },
    { "type": "text", "id": "address_line_1", "label": "Рядок 1", "default": "Велика Житомирська, 20" },
    { "type": "text", "id": "address_line_2", "label": "Рядок 2", "default": "Щодня 11:00–21:00 · NEWBORN K Київ" },
    { "type": "url", "id": "address_link", "label": "Посилання (Google Maps)" }
  ],
  "presets": [{ "name": "Halloween · Hero" }]
}
{% endschema %}
