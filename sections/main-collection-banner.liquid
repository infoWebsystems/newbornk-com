{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{% unless template contains 'collection' %}
<div class="page-width">
{% render 'breadcrumbs' %}
</div>
{% endunless%}
{% if section.settings.show_more_text %}
  {% assign description_lines = section.settings.description_lines %}
  {% assign description_lines_mob = section.settings.description_lines_mob %}
  <style>
    .collection-hero__description.less{
      display: -webkit-box;
      display: -moz-box;
      overflow: hidden;
      -moz-box-orient: vertical;
      -webkit-line-clamp: {{ description_lines }};
      line-clamp: {{ description_lines }};
      text-overflow: ellipsis;
      -webkit-box-orient: vertical;
      box-orient: vertical;
    }
    @media screen and (max-width: 768px) {
      .collection-hero__description.less{
        -webkit-line-clamp: {{ description_lines_mob }};
        line-clamp: {{ description_lines_mob }};
      }
    }
  </style>
{% endif %}

<div class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %}">
  <div class="collection-hero__inner page-width">
    <div class="collection-hero__text-wrapper">
      
      <div class='collection-hero__breadcrumbs'>
        {% render 'breadcrumbs' %}
      </div>

      {% capture title %}
        {% assign collection_vendor_size = collection.all_vendors | size %}
        {% if collection_vendor_size == 1 %}
          <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
          {% if collection.title == 'SALE' and current_tags != blank %}
            {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: " "}}{%- endcapture -%}
            {{ 'products.product.on_sale' | t }}: {{ current_tags | join: "  "}}
          {% else %}
            {{- collection.title | escape -}}
          {% endif %}
        {% else %}
          {{ collection.title }}
        {% endif %}
      {% endcapture %}

      <h1 style="display: none">{{ title }}</h1>

      {%- if section.settings.show_collection_title -%}
      <h2 class="collection-hero__title h1">
        {{ title}}
      </h2>
      {%- endif -%}

      {%- if section.settings.show_collection_description -%}
        <div class="collection-hero__description less rte" data-lines="{{ description_lines }}" data-lines-mob="{{ description_lines_mob }}">
          {{ collection.description }}
        </div>
      {%- endif -%}

      {% if section.settings.show_filter_w_m %}
        <div class="filter-w-m buttons-section hidden">
          {% assign collection_gender_men = collection.metafields.custom.collection_gender_men.value %}
          {% assign collection_gender_women = collection.metafields.custom.collection_gender_women.value %}
          {% if collection_gender_men != blank and collection_gender_women != blank %}
            <a href="{% if collection_gender_men.url == collection.url %}javascript:;{% else %}{{ collection_gender_men.url }}{% endif %}" class="button button--full-width button--primary {% if collection_gender_men.url == collection.url %}active{% endif %}">{{ section.settings.text_men }}</a>
            <a href="{% if collection_gender_women.url == collection.url %}javascript:;{% else %}{{ collection_gender_women.url }}{% endif %}" class="button button--full-width button--primary {% if collection_gender_women.url == collection.url %}active{% endif %}">{{ section.settings.text_women }}</a>
          {% else %}
            <a href="#" data-ident="men#@" class="button button--full-width button--primary default">{{ section.settings.text_men }}</a>
            <a href="#" data-ident="women#@" class=" button button--full-width button--primary">{{ section.settings.text_women }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media">
        <img srcset="{%- if collection.image.width >= 165 -%}{{ collection.image | img_url: '165x' }} 165w,{%- endif -%}
          {%- if collection.image.width >= 360 -%}{{ collection.image | img_url: '360x' }} 360w,{%- endif -%}
          {%- if collection.image.width >= 535 -%}{{ collection.image | img_url: '535x' }} 535w,{%- endif -%}
          {%- if collection.image.width >= 720 -%}{{ collection.image | img_url: '720x' }} 720w,{%- endif -%}
          {%- if collection.image.width >= 940 -%}{{ collection.image | img_url: '940x' }} 940w,{%- endif -%}
          {%- if collection.image.width >= 1070 -%}{{ collection.image | img_url: '1070x' }} 1070w{%- endif -%}"
          src="{{ collection.image | img_url: '533x' }}"
          sizes="(min-width: 1100px) 535px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.title | escape }}"
          loading="lazy"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "spaced-section spaced-section--full-width",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },{
      "type": "checkbox",
      "id": "show_more_text",
      "default": true,
      "label": "Enable more text?"
    },{
      "type": "number",
      "id": "description_lines",
      "default": 10,
      "label": "Descriptions lines desktop"
    },{
      "type": "number",
      "id": "description_lines_mob",
      "default": 7,
      "label": "Descriptions lines mobile"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label",
      "info": "t:sections.main-collection-banner.settings.show_collection_image.info"
    },
    {
      "type": "checkbox",
      "id": "show_collection_title",
      "default": false,
      "label": "Show collection title"
    },
    {
      "type": "checkbox",
      "id": "show_filter_w_m",
      "default": true,
      "label": "Show filter for women&men"
    },
    {
      "type": "text",
      "id": "text_women",
      "label": "Button text women"
    },
    {
      "type": "text",
      "id": "text_men",
      "label": "Button text men"
    }
  ]
}
{% endschema %}
