                    id="singleSelect4"
                    class="__select__input"
                    type="radio"
                    value="created-descending"
                    name="sort_by"
                    {% if sort_by == 'created-descending' %}
                      checked
                    {% endif %}
                  >
                  <label for="singleSelect4" class="__select__label">
                    <span>{{ 'collections.sorting.date_descending' | t }}</span>
