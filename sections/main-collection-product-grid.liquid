<div id="CollectionProductGrid" class="collection-products" total="{{ total_products }}" type="{%- if use_default == true -%}default{%- else -%}custom{%- endif -%}">
  {%- if total_products == 0 -%}
    <div class="collection collection--empty page-width" id="main-collection-product-grid" data-id="{{ section.id }}">
      <div class="loading-overlay">
        <div class="loading-overlay__spinner">
          <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
          </svg>
        </div>
      </div>

      <!--
        p class="collection-product-count light">
        {{ 'sections.collection_template.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}
        </p
      -->

      <div class="title-wrapper center">
        <h2 class="title title--primary">
          {% if settings.collection_empty_text != blank %}
            {{ settings.collection_empty_text }}
          {% else %}
            <br>
            {{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: 'underlined-link link' }}
          {% endif %}
        </h2>
      </div>
      {% render 'collection-empty-slider' %}
    </div>
  {%- else -%}
    <div class="collection page-width">
      <div class="loading-overlay">
        <div class="loading-overlay__spinner">
          <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
          </svg>
        </div>
      </div>

      <!--
        p class="collection-product-count light">
        {{ 'sections.collection_template.product_count' | t: product_count: collection.products_count, count: collection.all_products_count }}
        </p
      -->
      {% assign ul_class = 'grid grid--2-col grid--3-col-tablet grid--one-third-max grid--4-col-desktop grid--quarter-ma negative-margin' %}
      {% comment %}
        {% liquid

          assign ul_class = 'grid grid--2-col'
          if product_list.size < 4
            assign ul_class = ul_class | append: ' grid--' | append: product_list.size | append: '-col-table negative-margin'
          else
            if product_list.size == 4
              assign ul_class =  ul_class | append: ' grid--4-col-desktop negative-margin'
            else
              assign ul_class =  ul_class | append: ' grid--3-col-tablet grid--one-third-max grid--4-col-desktop grid--quarter-ma negative-margin'
            endif
          endif
        %}
      {% endcomment %}
      {% if use_default == true %}
        {%- paginate collection.products by section.settings.products_per_page -%}
          <ul
            id="main-collection-product-grid"
            data-id="{{ section.id }}"
            class="{{ ul_class }}"
          >
            {%- for product in collection.products -%}
              {% liquid
                capture can
                  render 'fn_validate_product', product: product
                endcapture
                assign can = can | plus: 0
              %}
              {% if can == 1 %}
                {%- capture variants_json -%}[{%- for v in product.variants -%}{"title":{{ v.title | json }},"available":{{ v.available | json }},"inventory_quantity":{{ v.inventory_quantity | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
                <li
                  class="grid__item"
                  data-product_id="{{ product.id }}"
                  data-variants="{{ variants_json | strip_newlines | strip | escape }}"
                >
                  {% render 'product-card',
                    product_card_product: product,
                    media_size: section.settings.image_ratio,
                    show_secondary_image: section.settings.show_secondary_image,
                    add_image_padding: section.settings.add_image_padding,
                    show_vendor: section.settings.show_vendor,
                    show_info: true,
                    type: 'collection_grid',
                    loop_index: forloop.index
                  %}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>

          {% if paginate.next %}
            <div
              class="load-more-container"
              data-page="{{ paginate.current_page }}"
              data-next-url="{{ paginate.next.url }}"
              data-section="{{ section.id }}"
            >
              <button class="load-more-btn">{{ 'text_btn_loadmore' | t }}</button>
              <div class="loading-spinner" style="display: none;">{{ 'text_loading' | t }}</div>
            </div>
          {% endif %}
          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate, anchor: '', class: '' %}
          {%- endif -%}
        {%- endpaginate -%}
      {% else %}
        <ul
          id="main-collection-product-grid"
          data-id="{{ section.id }}"
          class="{{ ul_class }}"
          min_index="{{ min_index }}"
          max_index="{{ max_index }}"
        >
          {% assign count_products = 0 %}
          {% assign index = 0 %}
          {%- for product_handle in product_list -%}
            {% assign index = index | plus: 1 %}

            {% if index < min_index or index > max_index %}
              {% continue %}
            {% endif %}

            {% assign product_obj = all_products[product_handle] %}

            {%- capture variants_json -%}[{%- for v in product_obj.variants -%}{"title":{{ v.title | json }},"available":{{ v.available | json }},"inventory_quantity":{{ v.inventory_quantity | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
            <li
              class="grid__item"
              data-product_id="{{ product_obj.id }}"
              data-variants="{{ variants_json | strip_newlines | strip | escape }}"
            >
              {% render 'product-card',
                product_card_product: product_obj,
                media_size: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                add_image_padding: section.settings.add_image_padding,
                show_vendor: section.settings.show_vendor,
                show_info: true,
                type: 'collection_grid',
                loop_index: forloop.index
              %}
            </li>

            {% assign count_products = count_products | plus: '1' %}

            {% if count_products >= limit %}
              {% break %}
            {% endif %}
          {%- endfor -%}
        </ul>
        {%- if total_pages > 1 -%}
          {% render 'pagination-custom', limit: limit, paged: paged, total_pages: total_pages, current_url: current_url %}
        {%- endif -%}
      {% endif %}
    </div>
  {%- endif -%}

  {% assign collection_description = collection.description %}
  {%- if section.settings.show_collection_description and show_collection_description and collection_description != blank -%}
    <div class="collection-hero__text-wrapper" style="width:100%;padding: 0 2.5rem;margin-top: 3rem;">
      <div class="collection-hero__description less rte" style="max-width: 100%;" data-lines="{{ description_lines }}" data-lines-mob="{{ description_lines_mob }}">
        {{ collection_description }}
      </div>
    </div>
  {%- endif -%}
</div>

