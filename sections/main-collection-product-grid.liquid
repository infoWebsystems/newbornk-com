                    id="singleSelect1"
                    class="__select__input"
                    type="radio"
                    value="price-ascending"
                    name="sort_by"
                    {% if sort_by == 'price-ascending' %}
                      checked
                    {% endif %}
                  >
                  <label for="singleSelect1" class="__select__label">
                    <span>{{ 'collections.sorting.price_ascending' | t }}</span>
                  </label>

                  <input
                    id="singleSelect2"
                    class="__select__input"
                    type="radio"
                    value="price-descending"
                    name="sort_by"
                    {% if sort_by == 'price-descending' %}
                      checked
                    {% endif %}
                  >
                  <label for="singleSelect2" class="__select__label">
                    <span>{{ 'collections.sorting.price_descending' | t }}</span>
                  </label>

                  <input
                    id="singleSelect3"
                    class="__select__input"
                    type="radio"
                    value="best-selling"
                    name="sort_by"
                    {% if sort_by == 'best-selling' %}
                      checked
                    {% endif %}
                  >
                  <label for="singleSelect3" class="__select__label">
                    <span>{{ 'collections.sorting.best_selling' | t }}</span>
                  </label>

