</style>
{% liquid
  assign show_collection_description = true
  assign page_number = canonical_url | split: 'page=' | last | split: '&' | first | plus: 0
  if canonical_url contains 'page=' and page_number > 1
    assign show_collection_description = false
  endif

  assign use_default = true
  assign total_products = collection.products_count

  if total_products <= 50
    assign use_default = false
  endif

  if use_default == false
    assign product_list = ''

    capture current_url
      assign curl = ''
      paginate collection.products by 1
        for part in paginate.parts
          if part.is_link == true
            assign curl = part.url
            break
          endif
        endfor
      endpaginate
      echo curl
    endcapture

    for product in collection.products
      capture can
        render 'fn_validate_product', product: product
      endcapture
      assign can = can | plus: 0

      if can == 1
        assign product_list = product_list | append: product.handle | append: ','
      endif
    endfor

    assign product_list = product_list | split: ',' | compact
    assign total_products = product_list.size

    if total_products > 0
      assign limit = section.settings.products_per_page

      assign paged = current_page

      assign count_products = 0

      assign limit_float = limit | divided_by: 1.0
      assign total_pages = total_products | divided_by: limit_float | ceil

      assign min_index = paged | minus: 1 | times: limit | plus: 1
      assign max_index = min_index | plus: limit | minus: 1
    endif
  endif
%}

