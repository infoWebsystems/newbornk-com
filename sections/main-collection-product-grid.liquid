<script>
  document.addEventListener('DOMContentLoaded', function () {
    const loadMoreContainers = document.querySelectorAll('.load-more-container');

    loadMoreContainers.forEach((container) => {
      const button = container.querySelector('.load-more-btn');
      const spinner = container.querySelector('.loading-spinner');
      let nextUrl = container.dataset.nextUrl || '';
      let page = container.dataset.page || 0;
      const sectionId = container.dataset.section;
      const productsGrid = document.getElementById('main-collection-product-grid');

      if (!nextUrl || !page) {
        button.style.display = 'none';
        spinner.style.display = 'none';
        return;
      }

      // Функция для извлечения параметров из URL
      function getUrlParams(url) {
        const params = {};
        const urlObj = new URL(url, window.location.origin);
        urlObj.searchParams.forEach((value, key) => {
          params[key] = value;
        });
        return params;
      }

      // Функция для построения URL с фильтрами
      function buildSectionUrl(basePath, pageNum, sectionId, currentParams) {
        const url = new URL(basePath, window.location.origin);

        // Добавляем параметры из текущего URL (фильтры)
        Object.keys(currentParams).forEach((key) => {
          if (key !== 'page') {
            // Не добавляем page, так как ставим свою
            url.searchParams.set(key, currentParams[key]);
          }
        });

        // Добавляем параметры для пагинации и секции
        url.searchParams.set('page', pageNum);
        url.searchParams.set('section_id', sectionId);

        return url.toString();
      }

      // Функция обновления пагинации
      function updatePaginationAfterLoad(newPage) {
        const paginationList = document.querySelector('.pagination__list');
        if (!paginationList) return;

        const items = paginationList.querySelectorAll('li');

        items.forEach((item) => {
          const link = item.querySelector('.pagination__item.link');
          if (!link) return;

          // Извлекаем номер страницы из href
          const match = link.href.match(/[?&]page=(\d+)/);
          if (!match) return;

          const pageNum = parseInt(match[1]);

          if (pageNum === newPage) {
            // Заменяем ссылку на span для текущей страницы
            const span = document.createElement('span');
            span.className = 'pagination__item pagination__item--current';
            span.setAttribute('aria-current', 'page');
            span.setAttribute('aria-label', `Сторінка ${pageNum}`);
            span.textContent = pageNum;

            link.parentNode.replaceChild(span, link);
          }
        });
      }

      button.addEventListener('click', async function () {
        try {
          button.style.display = 'none';
          spinner.style.display = 'block';

          const currentPage = parseInt(button.parentNode.dataset.page || 0);
          let nextUrl = button.parentNode.dataset.nextUrl || '';

          if (!nextUrl || !currentPage) {
            button.style.display = 'none';
            spinner.style.display = 'none';
            return;
          }

          // Получаем все параметры из текущего URL (включая фильтры)
          const currentParams = getUrlParams(window.location.href);
          const nextPageNum = currentPage + 1;

          // Строим URL с учетом всех фильтров
          const sectionUrl = buildSectionUrl(window.location.pathname, nextPageNum, sectionId, currentParams);

          const response = await fetch(sectionUrl);
          const html = await response.text();

          const temp = document.createElement('div');
          temp.innerHTML = html;

          // Получаем товары из загруженной секции
          const newProducts = temp.querySelector('#main-collection-product-grid')?.innerHTML;

          if (!newProducts) {
            throw new Error('Товары не найдены');
          }

          const idsSet = new Set();
          productsGrid.querySelectorAll('li.grid__item').forEach((el) => {
            const id = el.getAttribute('data-product_id');
            if (id) {
              idsSet.add(id.toString()); // Преобразуем в строку для надежности
            }
          });
          const existingIds = Array.from(idsSet);
          console.log('Существующие ID:', existingIds);

          // Создаем временный контейнер для новых товаров
          const tempContainer = document.createElement('div');
          tempContainer.innerHTML = newProducts;

          // Фильтруем новые товары, удаляя дубликаты
          const uniqueNewProducts = [];
          tempContainer.querySelectorAll('li.grid__item').forEach((el) => {
            const id = el.getAttribute('data-product_id');

            if (id && !existingIds.includes(id.toString())) {
              uniqueNewProducts.push(el.outerHTML);
              console.log('✓ Добавляем товар с ID:', id);
            } else {
              console.log('✗ Пропускаем дубликат с ID:', id);
            }
          });

          // Добавляем только уникальные товары
          if (uniqueNewProducts.length > 0) {
            productsGrid.insertAdjacentHTML('beforeend', uniqueNewProducts.join(''));
            console.log(`Добавлено ${uniqueNewProducts.length} новых товаров`);
          }

          // Добавляем товары
          //productsGrid.insertAdjacentHTML('beforeend', newProducts);

          // Обновляем пагинацию
          updatePaginationAfterLoad(nextPageNum);

          // Проверяем, есть ли следующая страница
          const newContainer = temp.querySelector('.load-more-container');
          if (newContainer && newContainer.dataset.nextUrl) {
            container.dataset.page = newContainer.dataset.page;
            container.dataset.nextUrl = newContainer.dataset.nextUrl;
            button.style.display = 'block';
            spinner.style.display = 'none';
          } else {
            // Больше нет страниц
            container.remove();
          }
        } catch (error) {
          button.style.display = 'none';
          spinner.style.display = 'none';
        }
      });
    });
  });
</script>
<script>
  const selectSingle = document.querySelector('.__select');
  const selectSingle_title = selectSingle.querySelector('.__select__title_content');
  const selectSingle_labels = selectSingle.querySelectorAll('.__select__label');

  // Toggle menu
  selectSingle_title.addEventListener('click', () => {
    if ('active' === selectSingle.getAttribute('data-state')) {
      selectSingle.setAttribute('data-state', '');
    } else {
      selectSingle.setAttribute('data-state', 'active');
    }
  });

  // Close when click to option
  for (let i = 0; i < selectSingle_labels.length; i++) {
    selectSingle_labels[i].addEventListener('click', (evt) => {
      selectSingle_title.textContent = evt.target.textContent;
      selectSingle.setAttribute('data-state', '');
    });
  }

  document.querySelector('.facets-button__open').onclick = function () {
    let hhop = document.querySelectorAll('.header__inline-menu--mobile');
    hhop.forEach((pop) => {
      pop.classList.add('header__inline-menu--mobile-block');
    });

    document.querySelector('.facets-button__box').classList.add('facets-button__box--before');
  };

  document.querySelector('.facets-box__icon--close').onclick = function () {
    let hhop = document.querySelectorAll('.header__inline-menu--mobile');
    hhop.forEach((top) => {
      top.classList.remove('header__inline-menu--mobile-block');
    });

    document.querySelector('.facets-button__box').classList.remove('facets-button__box--before');
  };

  let sel_2 = document.querySelectorAll('.__select-all');
  sel_2.forEach((selectSingle) => {
    let sel_1 = document.querySelectorAll('.__select__title_content-all');
    sel_1.forEach((selectSingle_title) => {
      const selectSingle_labels = selectSingle.querySelectorAll('.__select__label');

      // Toggle menu
      selectSingle_title.addEventListener('click', () => {
        if ('active' === selectSingle.getAttribute('data-state')) {
          selectSingle.setAttribute('data-state', '');
        } else {
          selectSingle.setAttribute('data-state', 'active');
        }
      });

      // Close when click to option
      for (let i = 0; i < selectSingle_labels.length; i++) {
        selectSingle_labels[i].addEventListener('click', (evt) => {
          selectSingle_title.textContent = evt.target.textContent;
          selectSingle.setAttribute('data-state', '');
        });
      }
    });
  });
</script>
