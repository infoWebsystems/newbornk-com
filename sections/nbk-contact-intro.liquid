<style>
#MainContent .nbk-contact-width .button {display: inline-flex; align-items: center; justify-content: center;}
#MainContent [id$="__form"] .form__label {color: #000;}
#MainContent [id$="__form"] .contact__button .button {display: inline-flex; align-items: center; justify-content: center;}

#MainContent [id$="__seo_page_heading"] > .nbk-page-heading,
#MainContent .nbk-contact-width,
#MainContent [id$="__1775141838ecb8939c"] > div,
#MainContent [id$="__info"] > .contact,
#MainContent [id$="__form"] > .contact {
  box-sizing: border-box;
  width: 100%;
  max-width: 950px;
  margin-left: auto;
  margin-right: auto;
  padding-left: 25px;
  padding-right: 25px;
  text-align: left;
}
#MainContent [id$="__conceptstore"],
#MainContent [id$="__1775141838ecb8939c"] {
  margin-top: 0;
  margin-bottom: 0;
}
#MainContent .nbk-contact-width .rte { margin-bottom: 40px !important; }
#MainContent [id$="__info"] > .contact,
#MainContent [id$="__form"] > .contact { margin-top: 56px; }
#MainContent [id$="__info"] .contact-block {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 36px 48px;
  padding: 36px;
  margin: 0;
  border-radius: 0;
  background: #CCF951;
}
#MainContent [id$="__info"] .contact__row { min-width: 0; }
#MainContent [id$="__info"] .contact-block__title {
  margin: 0 0 12px;
  font-size: 14px;
  line-height: 1.4;
}
#MainContent [id$="__info"] .contact-block__text,
#MainContent [id$="__info"] .contact-list__link {
  font-size: 16px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
#MainContent [id$="__info"] .contact-list { margin: 0; gap: 10px; }
#MainContent [id$="__info"] .contact--work-time { row-gap: 4px; column-gap: 16px; }
#MainContent [id$="__info"] a:hover { text-decoration: underline; text-underline-offset: 4px; }
#MainContent [id$="__form"] .contact-header { margin-bottom: 28px; }
#MainContent [id$="__form"] .contact-header__title {
  font-size: 26px;
  line-height: 1.3;
  margin: 0 0 16px;
}
#MainContent [id$="__form"] .contact-header__content {
  max-width: 680px;
  font-size: 16px;
  line-height: 1.6;
  margin: 0;
}
#MainContent [id$="__form"] .contact__fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
}
#MainContent [id$="__form"] .contact__fields > div { min-width: 0; }
#MainContent [id$="__form"] .form-text { grid-column: 1 / -1; }
#MainContent [id$="__form"] .form__label {
  display: block;
  visibility: visible;
  font-family: inherit;
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 8px;
}
#MainContent [id$="__form"] .form-input--required::after { content: none; }
#MainContent [id$="__form"] .form-input--required .form__label::after { content: " *"; }
#MainContent [id$="__form"] .form__input {
  width: 100%;
  min-height: 48px;
  margin: 0;
  padding: 12px 16px;
  border: 1px solid #000;
  border-radius: 0;
  background-color: #fff;
  font-family: inherit;
  font-size: 16px;
  line-height: 1.5;
}
#MainContent [id$="__form"] .form__select { appearance: auto; }
#MainContent [id$="__form"] .form__input::placeholder { font-size: 16px; line-height: 1.5; color: #666; }
#MainContent [id$="__form"] .form__text { min-height: 168px; resize: vertical; }
#MainContent [id$="__form"] .form__input:focus-visible,
#MainContent [id$="__info"] a:focus-visible {
  outline: 2px solid #000;
  outline-offset: 3px;
}
#MainContent [id$="__form"] .contact__button { margin-top: 24px; }
#MainContent [id$="__form"] .contact__button .button {
  width: auto;
  min-width: 240px;
  min-height: 48px;
  padding: 14px 28px;
  border-radius: 0;
  background: #000;
  color: #fff;
  font-family: inherit;
  font-size: 14px;
  line-height: 1.4;
}
#MainContent [id$="__form"] .contact__button .button:hover { background: #CCF951; color: #000; }
@media (max-width: 749px) {
  #MainContent [id$="__seo_page_heading"] > .nbk-page-heading,
  #MainContent .nbk-contact-width,
  #MainContent [id$="__1775141838ecb8939c"] > div,
  #MainContent [id$="__info"] > .contact,
  #MainContent [id$="__form"] > .contact { padding-left: 15px; padding-right: 15px; }
  #MainContent [id$="__info"] > .contact,
  #MainContent [id$="__form"] > .contact { margin-top: 40px; }
  #MainContent [id$="__info"] .contact-block { grid-template-columns: minmax(0, 1fr); gap: 28px; padding: 24px; }
  #MainContent [id$="__form"] .contact__fields { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  #MainContent [id$="__form"] .contact-header__title { font-size: 24px; }
  #MainContent [id$="__form"] .contact__button .button { width: 100%; min-width: 0; }
}
#MainContent [id$="__1775141838ecb8939c"] .reputon-widget { font-family: inherit; padding: 0; }
#MainContent [id$="__1775141838ecb8939c"] .reputon-location-content { padding: 24px; background: #fff; border: 1px solid #dedede; border-radius: 0; }
#MainContent [id$="__1775141838ecb8939c"] .reputon-location-content > div { border-radius: 0; }

#MainContent .nbk-contact-intro h2 { margin: 0 0 16px; }
#MainContent .nbk-contact-intro p { margin: 0 0 20px; line-height: 1.65; }
#MainContent .nbk-visit { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; border-top: 1px solid #000; padding-top: 28px; margin: 28px 0 40px; }
#MainContent .nbk-visit h3 { font-size: 14px; margin: 0 0 12px; }
#MainContent .nbk-visit .nbk-address { font-size: 22px; line-height: 1.4; margin-bottom: 12px; }
#MainContent .nbk-visit .nbk-hours { margin-bottom: 8px; }
#MainContent .nbk-visit .nbk-note { font-size: 14px; }
#MainContent .nbk-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; }
#MainContent .nbk-actions .button { background: #000; color: #fff; text-decoration: none; min-height: 48px; padding: 14px 24px; }
#MainContent .nbk-actions .button:hover { background: #CCF951; color: #000; }
#MainContent .nbk-contact-photos { display: grid; grid-template-columns: minmax(0,9fr) minmax(0,16fr); gap: 24px; margin: 0 0 40px; }
#MainContent .nbk-contact-photos img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; object-position: center 60%; }
#MainContent .nbk-contact-photos .nbk-contact-interior { aspect-ratio: 4 / 3; object-fit: contain; }
#MainContent .nbk-contact-width a:not(.button), #MainContent [id$="__info"] a, #MainContent [id$="__form"] a { color: #000; text-underline-offset: 4px; }
#MainContent .nbk-actions .button, #MainContent [id$="__form"] .contact__button .button { text-transform: uppercase; }
#MainContent [id$="__info"] .nbk-support-hours { grid-column: 1 / -1; margin: 0; font-size: 14px; }
#MainContent [id$="__legal"] .nbk-contact-width { border-top: 1px solid #dedede; padding-top: 24px; padding-bottom: 48px; }
#MainContent [id$="__legal"] h2 { font-size: 14px; margin: 0 0 12px; }
#MainContent [id$="__legal"] p { font-size: 14px; margin: 4px 0; }
#MainContent [id$="__form"] .nbk-help-links { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 16px; font-size: 14px; }
#MainContent [id$="__form"] .form-select { grid-column: 1 / -1; }
@media(max-width:749px) {
 #MainContent .nbk-visit { grid-template-columns: minmax(0,1fr); gap: 28px; }
 #MainContent .nbk-contact-photos { grid-template-columns: minmax(0,1fr); gap: 16px; }
 #MainContent .nbk-visit .nbk-address { font-size: 20px; }
}
</style>
<div class="page-width nbk-contact-width nbk-contact-intro">
  <h2>{{ 'nbk_contact.intro_title' | t }}</h2>
  <p>{{ 'nbk_contact.intro' | t }}</p>
  <div class="nbk-visit">
    <div>
      <h3>{{ 'nbk_contact.visit' | t }}</h3>
      <p class="nbk-address">{{ 'nbk_contact.address' | t }}</p>
      <p class="nbk-hours"><strong>{{ 'nbk_contact.daily' | t }}</strong></p>
      <p class="nbk-note">{{ 'nbk_contact.holidays' | t }}</p>
      <div class="nbk-actions">
        <a class="button" href="https://maps.app.goo.gl/VtaNBz5cXNtQKzAF6">{{ 'nbk_contact.route' | t }}</a>
        <a href="tel:+380970443333">{{ 'nbk_contact.call' | t }}</a>
      </div>
    </div>
    <div>
      <h3>{{ 'nbk_contact.parking_title' | t }}</h3>
      <p>{{ 'nbk_contact.parking' | t }}</p>
      <h3>{{ 'nbk_contact.pickup_title' | t }}</h3>
      <p>{{ 'nbk_contact.pickup' | t }}</p>
      <a href="{{ routes.collections_url }}/brands">{{ 'nbk_contact.brands' | t }}</a>
    </div>
  </div>
  {% if section.settings.exterior != blank or section.settings.interior != blank %}
    <div class="nbk-contact-photos">
      {% if section.settings.exterior != blank %}
        {% assign exterior_alt = 'nbk_contact.exterior_alt' | t %}
        {{ section.settings.exterior | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(min-width: 950px) 315px, (min-width: 750px) calc(36vw - 27px), calc(100vw - 30px)', loading: 'lazy', alt: exterior_alt }}
      {% endif %}
      {% if section.settings.interior != blank %}
        {% assign interior_alt = 'nbk_contact.interior_alt' | t %}
        {{ section.settings.interior | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(min-width: 950px) 561px, (min-width: 750px) calc(64vw - 47px), calc(100vw - 30px)', loading: 'lazy', class: 'nbk-contact-interior', alt: interior_alt }}
      {% endif %}
    </div>
  {% endif %}
</div>
{% schema %}
{"name":"NEWBORN K store visit","tag":"section","class":"shopify-section","settings":[{"type":"image_picker","id":"exterior","label":"Store entrance"},{"type":"image_picker","id":"interior","label":"Store interior"}]}
{% endschema %}
