{%- if section.settings.enable_language_selector and shop.locale == 'ru' -%}
  {% capture lang_switcher %}
    <div class="footer__column footer__localization">
      <noscript>
        {%- form 'localization', id: 'FooterLanguageFormNoScript', class: 'localization-form' -%}
          <div class="localization-form__select">
            <h2 class="visually-hidden" id="FooterLanguageLabelNoScript">{{ 'localization.language_label' | t }}</h2>
            <select class="localization-selector link" name="locale_code" aria-labelledby="FooterLanguageLabelNoScript">
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {%- if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                  {{ language.endonym_name | capitalize }}
                </option>
              {%- endfor -%}
            </select>
            {% render 'icon-caret' %}
          </div>
          <button class="button button--tertiary">{{ 'localization.update_language' | t }}</button>
        {%- endform -%}
      </noscript>
      <localization-form>
        {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
          {% if localization.language.iso_code == 'uk'%}
            {% assign localization_language_iso_code = 'uk' %}
          {% else %}
            {% assign localization_language_iso_code = localization.language.iso_code %}
          {% endif %}
          <div class="no-js-hidden">
            <!--h2 class="caption-large" id="FooterLanguageLabel">{{ 'localization.language_label' | t }}</h2-->
            <div class="ok disclosure">
              <button type="button" class="disclosure__button localization-form__select localization-selector link link--text caption-large" aria-expanded="false" aria-controls="FooterLanguageList" aria-describedby="FooterLanguageLabel">
                <span>{{ localization_language_iso_code | upcase }}</span>
                {% render 'icon-caret' %}
              </button>
              <ul id="FooterLanguageList" role="list" class="disclosure__list list-unstyled" hidden>
                {%- for language in localization.available_languages -%}
                  {% if language.iso_code == 'uk'%}
                    {% assign language_iso_code = 'uk' %}
                  {% else %}
                    {% assign language_iso_code = language.iso_code %}
                  {% endif %}
                  <li class="disclosure__item" tabindex="-1">
                    <a class="link link--text disclosure__link caption-large{% if language_iso_code == localization_language_iso_code %} disclosure__link--active{% endif %}
                          focus-inset"
                       href="/{% unless language.primary %}{{ language.iso_code }}{% endunless %} " hreflang="{{ language.iso_code }}"
                       lang="{{ language.iso_code }}"
                            {% if language_iso_code == localization_language_iso_code %} aria-current="true"{% endif %} data-value="{{ language.iso_code }}">
                      {{ language.name | capitalize }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
            <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}">
          </div>
        {%- endform -%}
      </localization-form>
    </div>
  {% endcapture %}
{%- endif -%}

<footer class="footer color-{{ section.settings.color_scheme }}">
  <div class="footer__content-top page-width page-width-full">
    <div class="footer__blocks">
      {% if section.settings.logo != blank or section.settings.newsletter_enable or section.settings.logo_svg %}
        <div class="footer__block">
          {% if section.settings.logo != blank or section.settings.logo_svg %}
            <div class="footer__logo">
              <figure{% if section.settings.logo_svg %} class="as--svg"{% endif %}>
                {% if section.settings.logo != blank %}
                  <img src="{{ section.settings.logo | img_url: '240x' }}" width="240" height="33" alt="Newbornk" loading="lazy">
                {% else %}
                  {% render 'icon-logo' %}
                {% endif %}
              </figure>
            </div>
          {% endif %}
          {% if section.settings.newsletter_enable %}
            <div class="footer__newsletter">
              {% render 'footer-newsletter' %}
            </div>
          {% endif %}
          <div class="footer__copy">&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}</div>
        </div>
      {% endif %}
      {% if section.settings.menu_left or section.settings.menu_bottom %}
        <div class="footer__block ">
          {% if section.settings.menu_left %}
            <ul class="footer__menu vertical--menu">
              {%- for link in section.settings.menu_left.links -%}
                {% if link.title == 'switcher' %}
                  {% if section.settings.enable_language_selector %}
                    <li>
                      {{ lang_switcher }}
                    </li>
                  {% endif %}
                {% else %}
                  <li>
                    <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">
                      {{ link.title }}
                    </a>
                  </li>
                {% endif %}
              {%- endfor -%}
            </ul>
          {% endif %}
          {% if section.settings.menu_bottom %}
            <ul class="footer__menu vertical--menu">
              {%- for link in section.settings.menu_bottom.links -%}
                <li>
                  <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">
                    {{ link.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {% endif %}
        </div>
      {% endif %}
      <div class="footer__block">
        {% if section.settings.menu_right != blank %}
          <ul class="footer__menu">
            {%- for link in section.settings.menu_right.links -%}
              <li>
                <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}">
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {% endif %}
        <div class="footer__contact">
          {% if section.settings.phone != blank %}
            {%- assign phone = section.settings.phone | replace: '(', '' | replace: ')', '' | replace: ' ', '' -%}
            <a href="tel:{{- phone -}}" class="footer__contact--phone">{{- section.settings.phone -}}</a>
          {% endif %}
          {% if section.settings.email != blank %}
            <a href="mailto:{{- section.settings.email -}}" class="footer__contact--email">{{- section.settings.email -}}</a>
          {% endif %}
          {% if section.settings.address_text != blank %}
            {% if section.settings.address_url != blank %}
              <a href="{{- section.settings.address_url -}}" class="footer__contact--address">{{- section.settings.address_text -}}</a>
            {% else %}
              <div class="footer__contact--address">{{- section.settings.address_text -}}</div>
            {% endif %}
          {% endif %}
        </div>
        <div class="footer__icons">
          <div class="footer__icon"><img src="{{ 'icon-mastercard.svg' | asset_url }}" width="51" height="32" alt="mastercard" loading="lazy"></div>
          <div class="footer__icon"><img src="{{ 'icon-visa.svg' | asset_url }}" width="51" height="32" alt="visa" loading="lazy"></div>
          <div class="footer__icon"><img src="{{ 'icon-applepay.svg' | asset_url }}" width="51" height="32" alt="applepay" loading="lazy"></div>
          <div class="footer__icon"><img src="{{ 'icon-googlepay.svg' | asset_url }}" width="51" height="32" alt="googlepay" loading="lazy"></div>
        </div>
        <div class="footer__copy-mobile">&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}</div>
      </div>
    </div>
  </div>
</footer>

{% javascript %}
  class LocalizationForm extends HTMLElement {
    constructor() {
      super();
      this.elements = {
        input: this.querySelector('input[name="locale_code"], input[name="country_code"]'),
        button: this.querySelector('button'),
        panel: this.querySelector('ul'),
      };
      this.elements.button.addEventListener('click', this.openSelector.bind(this));
      this.elements.button.addEventListener('focusout', this.closeSelector.bind(this));
      this.querySelectorAll('a').forEach((item) => item.addEventListener('click', this.onItemClick.bind(this)));
    }

    onItemClick(event) {
      event.preventDefault();
      this.elements.input.value = event.currentTarget.dataset.value;
      this.querySelector('form')?.submit();
    }

    openSelector() {
      this.elements.button.focus();
      this.elements.panel.toggleAttribute('hidden');
      this.elements.button.setAttribute('aria-expanded', (this.elements.button.getAttribute('aria-expanded') === 'false').toString());
    }

    closeSelector(event) {
      const shouldClose = event.relatedTarget && event.relatedTarget.nodeName === 'BUTTON';
      if (event.relatedTarget === null || shouldClose) {
        this.elements.button.setAttribute('aria-expanded', 'false');
        this.elements.panel.setAttribute('hidden', true);
      }
    }
  }

  customElements.define('localization-form', LocalizationForm);
{% endjavascript %}

