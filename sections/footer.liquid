      "info": "t:sections.footer.blocks.link_list.settings.menu.info"
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "text",
      "label": "E-mail",
      "id": "email",
      "default": "info@newbornk.com"
    },
    {
      "type": "text",
      "label": "Phone",
      "id": "phone",
      "default": "+380 97 044 3333"
    },
    {
      "type": "text",
      "label": "Address",
