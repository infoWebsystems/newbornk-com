# we use Shopify as our ecommerce platform
{%- comment -%}
# Caution! Please read https://help.shopify.com/en/manual/promoting-marketing/seo/editing-robots-txt before proceeding to make changes to this file.
{% endcomment %}
{% for group in robots.default_groups %}
  {{- group.user_agent -}}

  {% for rule in group.rules %}
    {{- rule -}}
  {% endfor %}

  {%- if group.user_agent.value == '*' -%}
{{ 'Disallow: */vendors?q=*' }} 
{{ 'Disallow: /*.p.vendor=*' }}
  {%- endif -%}

  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {%- endif -%}
{% endfor %}

{%- comment -%}
# Explicit groups for AI/LLM crawlers (tech audit 2026, item 4).
# Each group mirrors the default '*' rules: a crawler that matches a named
# group ignores the '*' group entirely, so a bare "Allow: /" here would
# open /cart, /checkout, /search etc. to these bots.
{%- endcomment -%}
{%- assign ai_bots = 'GPTBot,Google-Extended,bingbot,ClaudeBot,CCBot,PerplexityBot' | split: ',' -%}
{% for bot in ai_bots %}
User-agent: {{ bot }}
Allow: /
{% for group in robots.default_groups -%}
  {%- if group.user_agent.value == '*' -%}
    {%- for rule in group.rules -%}
      {{- rule -}}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{{- 'Disallow: */vendors?q=*' }}
{{ 'Disallow: /*.p.vendor=*' }}
{% endfor %}
